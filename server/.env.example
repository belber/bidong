# 运行模式：本地开发默认 true；生产设 false
DEV_MODE=true

# 数据库：本地开发用 SQLite 即可；生产换成 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/bili_collector
DATABASE_URL=sqlite:///./var/bili.db

# JWT
JWT_SECRET=please-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=43200

# 微信小程序（上线时填写）
WECHAT_APPID=
WECHAT_SECRET=

# 媒体下载开关（默认关闭，审核期间保持 false）
ENABLE_WATERMARKED_VIDEO=false
ENABLE_CLEAN_VIDEO=false
ENABLE_AUDIO=false

# 封面转存：local 本地落盘 / cos 腾讯云 COS
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/covers
PUBLIC_BASE_URL=http://127.0.0.1:8000

# COS（STORAGE_BACKEND=cos 时填写）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 机器人（Phase 1，默认关闭；用 python -m app.robot.login 扫码写入）
ROBOT_ENABLED=false
ROBOT_UID=
ROBOT_SESSDATA=
ROBOT_BILI_JCT=
ROBOT_DEDEUSERID=
ROBOT_BUVID3=
ROBOT_BUVID4=
ROBOT_POLL_INTERVAL_SECONDS=45
ROBOT_SEND_INTERVAL_SECONDS=5
# 只给最近 N 秒内关注的粉丝发码（1800 = 30 分钟）
ROBOT_FOLLOW_WINDOW_SECONDS=1800
