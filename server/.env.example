# 运行模式：本地开发默认 true；生产设 false
DEV_MODE=true

# 数据库：本地开发用 SQLite 即可；生产换成 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/bili_collector
DATABASE_URL=sqlite:///./var/bili.db

# 解析结果内存缓存时长（秒），重复解析同一链接时快速返回
PARSE_CACHE_SECONDS=60

# JWT
JWT_SECRET=please-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=43200

# 微信小程序（上线时填写）
WECHAT_APPID=
WECHAT_SECRET=

# 媒体下载开关（默认关闭，审核期间保持 false）
ENABLE_WATERMARKED_VIDEO=false
ENABLE_CLEAN_VIDEO=false
ENABLE_AUDIO=false

# 解析/展示开关（审核期可在管理后台调整）
ENABLE_COMMENT=true
ENABLE_DANMAKU=true
ENABLE_ROBOT_GUIDE=true
ENABLE_SHARE=true

# 封面转存：local 本地落盘 / cos 腾讯云 COS
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/covers
PUBLIC_BASE_URL=http://127.0.0.1:8000

# COS（STORAGE_BACKEND=cos 时填写）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 机器人（Phase 1，默认关闭；用 python -m app.robot.login 扫码写入）
ROBOT_ENABLED=false
ROBOT_UID=
ROBOT_SESSDATA=
ROBOT_BILI_JCT=
ROBOT_DEDEUSERID=
ROBOT_BUVID3=
ROBOT_BUVID4=
ROBOT_POLL_INTERVAL_SECONDS=30
ROBOT_SEND_INTERVAL_SECONDS=5
# 只给最近 N 秒内关注的粉丝发码（1800 = 30 分钟）
ROBOT_FOLLOW_WINDOW_SECONDS=1800

# 抖音图文第三方解析（DTK v5 兼容；也可在管理端填写）
DOUYIN_NOTE_API_ENABLED=false
DOUYIN_NOTE_API_BASE_URL=
DOUYIN_NOTE_API_KEY=
DOUYIN_NOTE_API_WAIT_SECONDS=20

# 后台管理端（PC Web，独立端口；登录密码务必修改）
ADMIN_PORT=8081
ADMIN_PASSWORD=admin-dev-password

# 运营通知（邮件 + Server 酱）
# SMTP 用 465 = SSL，587 = STARTTLS
ALERT_ENABLED=false
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Server 酱 SendKey（在 https://sct.ftqq.com/sendkey 获取）
SERVERCHAN_SENDKEY=

# 告警类型开关
ALERT_COOKIE_ENABLED=true
ALERT_DOMAIN_ENABLED=true
# 解析服务故障：只走 Server 酱；同类型一次，每天最多一条
ALERT_FAULT_ENABLED=true

# 每日运营报告
REPORT_ENABLED=false
REPORT_TIME=09:00

# 小程序「帮助与反馈」页展示的 QQ 群号（默认空；也可在管理后台配置）
HELP_QQ_GROUP=

# 视频出处（原up主）：只服务 B站账号「帅哥录屏」的粉丝溯源
# 内容由家里小主机上报，接口见 docs/视频出处上报接口.md
REPOST_UP_MID=3707052465589015
REPOST_ACCOUNT_NAME=帅哥录屏
REPOST_ACCOUNT_AVATAR_URL=
SOURCE_INGEST_TOKEN=

# 微信搜索：爬虫访问可验证签名（小程序后台「消息推送」里的 Token，可留空）
WECHAT_MSG_TOKEN=

# 视频文案：只有用户点击提取才排队；平台字幕优先。
# 默认关闭ASR，模型初始化完成后再打开。文案worker仍可读取平台字幕。
TRANSCRIPT_ENGINE=sensevoice
TRANSCRIPT_SENSEVOICE_MODEL_PATH=./var/models/sensevoice/model.int8.onnx
TRANSCRIPT_SENSEVOICE_TOKENS_PATH=./var/models/sensevoice/tokens.txt
TRANSCRIPT_CHUNK_SECONDS=12
TRANSCRIPT_CHUNK_CONTEXT_SECONDS=1
TRANSCRIPT_ASR_ENABLED=false
TRANSCRIPT_WHISPER_BIN=whisper-cli
TRANSCRIPT_MODEL_PATH=./var/models/ggml-base-q5_1.bin
TRANSCRIPT_VAD_PATH=./var/models/silero_vad.onnx
TRANSCRIPT_FFMPEG_BIN=ffmpeg
TRANSCRIPT_TEMP_DIR=./var/transcript-tmp
TRANSCRIPT_MAX_SECONDS=1800
TRANSCRIPT_MAX_BYTES=268435456
TRANSCRIPT_TIMEOUT_SECONDS=7200
TRANSCRIPT_QUEUE_LIMIT=10
TRANSCRIPT_LANGUAGE=zh
TRANSCRIPT_CACHE_VERSION=sensevoice-20240717-int8-ctc-v2

# Complete-video preparation: independent worker, no speech recognition.
VIDEO_DOWNLOAD_CACHE_DIR=./var/video-downloads
VIDEO_DOWNLOAD_FFMPEG_BIN=ffmpeg
VIDEO_DOWNLOAD_MAX_INPUT_BYTES=536870912
VIDEO_DOWNLOAD_CACHE_MAX_BYTES=2147483648
VIDEO_DOWNLOAD_CACHE_SECONDS=1800
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
VIDEO_DOWNLOAD_QUEUE_LIMIT=10
