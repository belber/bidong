# 运行模式：本地开发默认 true；生产设 false
DEV_MODE=true

# 数据库：本地开发用 SQLite 即可；生产换成 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/bili_collector
DATABASE_URL=sqlite:///./var/bili.db

# 解析结果内存缓存时长（秒），重复解析同一链接时快速返回
PARSE_CACHE_SECONDS=60

# JWT
JWT_SECRET=please-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=43200

# 微信小程序（上线时填写）
WECHAT_APPID=
WECHAT_SECRET=

# 媒体下载开关（默认关闭，审核期间保持 false）
ENABLE_WATERMARKED_VIDEO=false
ENABLE_CLEAN_VIDEO=false
ENABLE_AUDIO=false

# 解析/展示开关（审核期可在管理后台调整）
ENABLE_COMMENT=true
ENABLE_DANMAKU=true
ENABLE_ROBOT_GUIDE=true
ENABLE_SHARE=true

# 封面转存：local 本地落盘 / cos 腾讯云 COS
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/covers
PUBLIC_BASE_URL=http://127.0.0.1:8000

# COS（STORAGE_BACKEND=cos 时填写）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 机器人（Phase 1，默认关闭；用 python -m app.robot.login 扫码写入）
ROBOT_ENABLED=false
ROBOT_UID=
ROBOT_SESSDATA=
ROBOT_BILI_JCT=
ROBOT_DEDEUSERID=
ROBOT_BUVID3=
ROBOT_BUVID4=
ROBOT_POLL_INTERVAL_SECONDS=30
ROBOT_SEND_INTERVAL_SECONDS=5
# 只给最近 N 秒内关注的粉丝发码（1800 = 30 分钟）
ROBOT_FOLLOW_WINDOW_SECONDS=1800

# 后台管理端（PC Web，独立端口；登录密码务必修改）
ADMIN_PORT=8081
ADMIN_PASSWORD=admin-dev-password

# Cookie 失效告警邮件（SMTP 用 465 = SSL，587 = STARTTLS）
ALERT_ENABLED=false
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 小程序「帮助与反馈」页展示的 QQ 群号（默认空；也可在管理后台配置）
HELP_QQ_GROUP=
