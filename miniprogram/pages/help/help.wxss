page { background: #F6F4F2; }
.page { padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom)); }
.section { padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 32rpx; font-weight: 650; color: #2B1E23; }
.supported { font-size: 24rpx; color: #94868B; line-height: 1.6; margin: 10rpx 0 24rpx; }
.step { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 0; color: #51474B; font-size: 28rpx; }
.step-number { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 50%; background: #FFF0F5; color: #E95F89; font-size: 24rpx; font-weight: 600; }
.questions { padding-bottom: 8rpx; }
.questions .sec-title { margin-bottom: 12rpx; }
.faq + .faq { border-top: 1rpx solid #F3EDF0; }
.question { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; padding: 18rpx 0; }
.question-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 500; color: #3D3338; }
.chevron { flex-shrink: 0; color: #AC929C; font-size: 30rpx; line-height: 1; transform: rotate(0); }
.chevron.expanded { transform: rotate(180deg); color: #E95F89; }
.answer { padding: 0 0 24rpx; font-size: 26rpx; color: #82727A; line-height: 1.85; white-space: pre-wrap; word-break: break-word; }
.robot { padding-top: 8rpx; padding-bottom: 8rpx; }
.feedback-tip { margin: 10rpx 0 22rpx; color: #94868B; font-size: 26rpx; }
.group-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16rpx; }
.group-label { font-size: 24rpx; color: #94868B; min-width: 0; overflow-wrap: anywhere; }
.group-no { font-size: 30rpx; color: #51474B; font-weight: 600; margin-left: 8rpx; }
.copy-group { flex-shrink: 0; margin: 0; padding: 12rpx 24rpx; background: #FFF0F5; color: #E95F89; border-radius: 999rpx; font-size: 25rpx; line-height: 1.5; }
