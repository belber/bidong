.page {
  padding: 32rpx;
  background: #FFFFFF;
  min-height: 100vh;
}

.section {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 34rpx;
  font-weight: 750;
  color: #2B1E23;
  margin-bottom: 20rpx;
}

.step {
  font-size: 30rpx;
  color: #5A4A50;
  line-height: 1.7;
  padding: 4rpx 0;
}

.faq {
  padding: 14rpx 0;
  border-top: 1rpx solid #FBF0F3;
}

.faq:first-of-type {
  border-top: none;
}

.q {
  font-size: 30rpx;
  font-weight: 650;
  color: #2B1E23;
}

.a {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #7A6A70;
  line-height: 1.6;
}

.group {
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.group-no {
  font-size: 44rpx;
  font-weight: 750;
  color: #2B1E23;
  letter-spacing: 0.04em;
}

.copy {
  font-size: 28rpx;
  font-weight: 700;
  color: #FB7299;
  border: 2rpx solid #FB7299;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.group-tip {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #B28B97;
}
