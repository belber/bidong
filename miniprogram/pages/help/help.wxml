<view class="page">
  <view class="section card quick-start">
    <view class="sec-title">快速上手</view>
    <view class="supported">支持 B站、BV 号、b23.tv 和抖音分享链接</view>
    <view class="step"><text class="step-number">1</text><text>粘贴链接 → 解析视频</text></view>
    <view class="step"><text class="step-number">2</text><text>下载视频或音频 → 保存</text></view>
    <view class="step"><text class="step-number">3</text><text>需要文字 → 提取文案</text></view>
  </view>

  <view class="section card questions">
    <view class="sec-title">常见问题</view>
    <view class="faq" wx:for="{{faqs}}" wx:key="id">
      <view class="question" bindtap="onToggleFaq" data-id="{{item.id}}" aria-role="button" aria-expanded="{{expandedFaq === item.id}}">
        <text class="question-title">{{item.title}}</text>
        <text class="chevron {{expandedFaq === item.id ? 'expanded' : ''}}">⌄</text>
      </view>
      <view class="answer" wx:if="{{expandedFaq === item.id}}">{{item.answer}}</view>
    </view>
  </view>

  <view class="section card robot" wx:if="{{showRobotGuide}}">
    <view class="question" bindtap="onToggleRobot" aria-role="button" aria-expanded="{{robotExpanded}}">
      <text class="question-title">机器人收藏（B站）</text>
      <text class="chevron {{robotExpanded ? 'expanded' : ''}}">⌄</text>
    </view>
    <view class="answer" wx:if="{{robotExpanded}}">先关注 @壁咚咚私藏，收到私信激活码后，在「我的」完成绑定。再到 B站视频评论区 @壁咚咚私藏，视频就会自动进入收藏夹。</view>
  </view>

  <view class="section card feedback" wx:if="{{showGroup}}">
    <view class="sec-title">联系反馈</view>
    <view class="feedback-tip">问题或建议，欢迎进群反馈</view>
    <view class="group-row">
      <view class="group-label">QQ 群 <text class="group-no">{{groupNo}}</text></view>
      <button class="copy-group" bindtap="onCopyGroup">复制群号</button>
    </view>
  </view>
</view>
