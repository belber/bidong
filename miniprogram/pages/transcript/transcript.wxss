page { background: #FFFFFF; }
.transcript-page { padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); }
.document-header { padding: 12rpx 4rpx 32rpx; }
.document-title { font-size: 33rpx; font-weight: 650; line-height: 1.6; word-break: break-all; }
.document-meta { margin-top: 18rpx; color: #9B9396; font-size: 25rpx; }
.document-tabs { display: flex; padding: 6rpx; border-radius: 26rpx; background: #FDF0F5; margin: 12rpx 0 26rpx; }
.document-tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 29rpx; font-weight: 600; color: #785D67; border-radius: 22rpx; }
.document-tab.selected { color: #FFFFFF; background: #FB7299; }
.document-line { display: flex; gap: 26rpx; padding: 28rpx 0; border-bottom: 1rpx solid #F4EEF0; align-items: flex-start; }
.document-time { flex-shrink: 0; color: #FB7299; background: #FFF1F6; border-radius: 10rpx; padding: 2rpx 12rpx; font-size: 25rpx; margin-top: 3rpx; font-variant-numeric: tabular-nums; }
.document-text,.document-plain { font-size: 30rpx; line-height: 1.85; color: #2D282A; word-break: break-all; white-space: pre-wrap; }
.document-text { flex: 1; min-width: 0; }
.document-plain { display: block; padding: 20rpx 4rpx; }
.document-notice { font-size: 23rpx; color: #A38C95; padding: 30rpx 0; }
.document-empty,.document-error { color: #A1808D; text-align: center; padding: 60rpx 12rpx; font-size: 28rpx; }
.document-actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx; background: #FFFFFF; padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #FAF2F5; }
.document-actions button { flex: 1; margin: 0; border-radius: 24rpx; padding: 18rpx 0; font-size: 30rpx; font-weight: 600; line-height: 1.6; }
.document-copy { color: #FB7299; background: #FFF0F5; }
.document-export { background: #FB7299; color: #FFFFFF; }
.summary-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #FFF6F9; border-radius: 18rpx; padding: 14rpx 20rpx; margin-bottom: 24rpx; }
.summary-entry-hint { font-size: 25rpx; color: #917480; min-width: 0; }
.summary-entry-button { flex-shrink: 0; margin: 0; padding: 8rpx 0 8rpx 12rpx; background: transparent; color: #E95F89; font-size: 26rpx; font-weight: 600; line-height: 1.6; }
.summary-overlay { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 44rpx; }
.summary-mask { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background: rgba(37, 28, 32, .38); }
.summary-confirm { position: relative; width: 100%; max-width: 640rpx; padding: 38rpx 30rpx 28rpx; border-radius: 26rpx; background: #FFFFFF; text-align: center; }
.summary-confirm-title { color: #2D282A; font-size: 32rpx; font-weight: 650; }
.summary-confirm-text { margin: 18rpx 0 32rpx; font-size: 27rpx; color: #94868B; line-height: 1.7; }
.summary-confirm-actions { display: flex; gap: 18rpx; }
.summary-confirm-actions .summary-cancel,.summary-confirm-actions .summary-go { flex: 1; width: 0; min-width: 0; margin: 0; padding: 18rpx 8rpx; line-height: 1.6; font-size: 28rpx; border-radius: 16rpx; }
.summary-cancel { background: #F8F4F6; color: #917480; }
.summary-go { background: #FB7299; color: #FFFFFF; }
