<view class="transcript-page">
  <view class="document-header">
    <view class="document-title">{{title || '视频文案'}}</view>
    <view class="document-meta">{{author}}<text wx:if="{{durationText}}"> · 时长 {{durationText}}</text><text wx:if="{{languageText}}"> · {{languageText}}</text></view>
  </view>
  <view class="document-tabs" wx:if="{{transcript.status === 'completed'}}">
    <view class="document-tab {{tab === 'timeline' ? 'selected' : ''}}" data-tab="timeline" bindtap="onTab">时间轴文案</view>
    <view class="document-tab {{tab === 'plain' ? 'selected' : ''}}" data-tab="plain" bindtap="onTab">纯文本</view>
  </view>
  <view class="document-error" wx:if="{{transcriptReadError}}" bindtap="onRetryRead">{{transcriptReadError}} · 点击重新加载</view>
  <block wx:if="{{transcript.status === 'completed'}}">
    <view wx:if="{{tab === 'timeline'}}">
      <view class="document-line" wx:for="{{lines}}" wx:key="index"><text class="document-time">{{item.timeText}}</text><text class="document-text" selectable>{{item.text}}</text></view>
    </view>
    <text class="document-plain" wx:else selectable>{{plainText}}</text>
    <view class="document-notice" wx:if="{{transcript.source === 'asr'}}">语音识别结果仅供参考，背景音乐、口音或噪声可能影响准确性。</view>
  </block>
  <view class="document-empty" wx:else>{{transcript.label}}</view>
  <view class="document-actions" wx:if="{{transcript.status === 'completed'}}">
    <button class="document-copy" bindtap="onCopyText">复制全文</button>
    <button class="document-export" bindtap="onExportTxt" disabled="{{exportState === 'downloading'}}">{{exportState === 'downloading' ? '下载中' : exportState === 'ready' ? '转发到微信' : '导出TXT'}}</button>
  </view>
</view>
