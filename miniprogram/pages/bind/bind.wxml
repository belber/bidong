<view class="page">
  <view class="intro">关注 B站 @壁咚收藏夹，机器人会私信你激活码；把激活码粘贴到这里完成绑定</view>

  <block wx:if="{{bound}}">
    <view class="ok-card">
      <view class="ok-icon">✓</view>
      <view class="ok-title">已绑定 @壁咚收藏夹</view>
      <view class="ok-sub">B站 UID：{{biliUid}}</view>
      <view class="ok-note">之后在视频评论区 @壁咚收藏夹，就能把视频收进收藏夹。</view>
    </view>
  </block>

  <block wx:else>
    <view class="input-box">
      <input
        class="input"
        placeholder="粘贴激活码"
        placeholder-class="ph"
        value="{{code}}"
        bindinput="onInput"
      />
      <text class="paste" bindtap="onPaste">粘贴</text>
    </view>
    <button class="btn-primary bind-btn" bindtap="onBind" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '绑定中…' : '绑定'}}
    </button>
    <view class="tip">没收到激活码？① 先关注 @壁咚收藏夹 ② 查看 B站私信消息</view>
  </block>
</view>
