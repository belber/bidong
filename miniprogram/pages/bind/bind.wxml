<view class="page">
  <view class="intro">关注B站 @壁咚收藏夹 会私信激活码，粘贴到此可绑定</view>

  <view class="input-box">
    <input
      class="input"
      placeholder="粘贴激活码"
      placeholder-class="ph"
      value="{{code}}"
      bindinput="onInput"
    />
    <text class="paste" bindtap="onPaste">粘贴</text>
  </view>

  <button class="btn-primary bind-btn" bindtap="onBind">绑定</button>
</view>
