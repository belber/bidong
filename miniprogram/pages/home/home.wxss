.page {
  padding: 12rpx 24rpx 16rpx;
  background: #FFFFFF;
  min-height: calc(100vh - 176rpx);
}

.input-box {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 8rpx;
  background: #FFFFFF;
  border: 2rpx solid #FB7299;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(251, 114, 153, 0.10);
}

.lk-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.input {
  flex: 1;
  font-size: 32rpx;
  color: #2B1E23;
  line-height: 1.5;
  height: 192rpx;
  min-height: 192rpx;
  background: transparent;
}

.ph {
  color: #B9B3AC;
  font-size: 30rpx;
  line-height: 1.5;
}

.paste {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #FB7299;
}

/* 识别到的平台：贴在输入框右下角，不占额外高度 */
.plat-chip {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 99rpx;
  background: #FB7299;
  color: #FFFFFF;
}

.plat-chip.dy {
  background: #161823;
}

.parse-btn {
  margin-top: 10rpx;
  font-size: 32rpx;
  padding: 12rpx 0 14rpx;
  border-radius: 22rpx;
  /* 主文案 + 平台说明两行；min-height 让「解析中」状态和常态等高，避免按钮跳一下。
     比最初的 86rpx 略高一档就够，太高反而是个突兀的色块 */
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

/* 平台说明压在主文案下面一层：字号小、轻微透明，不抢焦点 */
.parse-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  opacity: 0.85;
}

.parse-btn.parsing {
  position: relative;
  overflow: hidden;
  opacity: 0.88;
}

.parse-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 30rpx;
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.shimmer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.shimmer::before {
  content: '';
  position: absolute;
  top: 0;
  left: -60%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0));
  animation: shimmer 1.4s infinite;
}

@keyframes shimmer {
  0% {
    left: -60%;
  }
  100% {
    left: 120%;
  }
}

.input-box.scanning {
  position: relative;
  overflow: hidden;
}

.input-box.scanning::before {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: -60%;
  height: 60%;
  background: linear-gradient(180deg, rgba(251, 114, 153, 0), rgba(251, 114, 153, 0.2), rgba(251, 114, 153, 0));
  animation: scan 1.6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes scan {
  0% {
    top: -60%;
  }
  100% {
    top: 120%;
  }
}

.guide-card {
  /* 和解析按钮之间留够呼吸：真机上按钮和卡片贴太近会显得挤 */
  margin-top: 28rpx;
  padding: 14rpx 16rpx;
  background: #FFFDFE;
  border: 3rpx dashed #F0C9D4;
  border-radius: 22rpx;
}

.guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-title {
  font-size: 26rpx;
  color: #B28B97;
  letter-spacing: 0.06em;
}

.guide-toggle {
  font-size: 22rpx;
  color: #FB7299;
}

.guide-summary {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8F7A82;
}

.guide-steps {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #7A6A70;
  white-space: nowrap;
}

.guide-step .n {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex: none;
  background: #FB7299;
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 24rpx;
  text-align: center;
}

.step-arrow {
  flex: none;
  font-size: 20rpx;
  color: #D9B8C3;
}

.demo {
  background: #F6F7F8;
  border-radius: 14rpx;
  padding: 8rpx 10rpx;
}

.demo-comment {
  margin-top: 0;
  display: flex;
  gap: 12rpx;
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
  border-radius: 10rpx;
  padding: 6rpx 8rpx;
}

.demo-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex: none;
  background: linear-gradient(135deg, #FB7299, #ff9db9);
}

.demo-cbody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.demo-cname {
  font-size: 18rpx;
  color: #9499A0;
}

.demo-ctext {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #2B1E23;
}

.demo-ctext.highlight {
  color: #FB7299;
  font-weight: 700;
}

.way {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F7E4EA;
}

.way:first-of-type {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.way-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2B1E23;
  margin-bottom: 8rpx;
}

.share-demo {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 14rpx;
  padding: 8rpx 10rpx 16rpx;
}

.share-head {
  font-size: 22rpx;
  color: #7A6A70;
  padding: 0 4rpx 4rpx;
}

.share-row {
  display: flex;
  justify-content: space-around;
}

.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 90rpx;
}

.share-ic {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #F6F7F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.share-item.on .share-ic {
  background: #FDE4EC;
}

.share-item.on .share-name {
  color: #FB7299;
  font-weight: 700;
}

.share-ic.wx {
  background: #07C160;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.share-ic.pyq {
  background: #1989FA;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.share-name {
  font-size: 18rpx;
  color: #7A6A70;
}

.share-arrow {
  position: absolute;
  right: 26%;
  bottom: 6rpx;
  font-size: 38rpx;
  color: #FF7A00;
  font-weight: 700;
}

.home-footer-note {
  /* 底部避让：自定义 tab bar + iPhone 安全区 */
  margin: 12rpx 8rpx calc(env(safe-area-inset-bottom) + 160rpx);
  text-align: center;
  font-size: 22rpx;
  color: #B28B97;
  line-height: 1.6;
}

.parse-tip {
  margin: 12rpx 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #B28B97;
}

.ad-banner {
  /* 高度交给广告组件自己决定：真机素材比 20:7 更扁时，固定高度会在广告下方空出一条。
     代价是广告加载完成后下方内容会轻微下移（原来靠固定高度锁住布局）。 */
  width: calc(100vw - 48rpx);
  height: auto;
  /* 贴在「如何获取链接」引导卡之后，作为页面底部的独立一条。
     间距挂在这里（而不是卡片的 margin-bottom），广告加载失败被 wx:if 隐藏时不会留下孤立空白 */
  margin-top: 28rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
