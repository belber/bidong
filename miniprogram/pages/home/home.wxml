<custom-navbar />

<view class="page">
  <view class="input-box {{parsing ? 'scanning' : ''}}">
    <image class="lk-icon" src="/images/icon-link.png" mode="aspectFit" />
    <textarea
      class="input"
      placeholder="{{demoPlaceholder}}"
      placeholder-class="ph"
      value="{{input}}"
      bindinput="onInput"
      maxlength="200"
    />
    <text class="paste" bindtap="onPaste">粘贴</text>
  </view>

  <button class="btn-primary parse-btn {{parsing ? 'parsing' : ''}}" bindtap="onParse">
    <view wx:if="{{parsing}}" class="parse-loading">
      <view class="spinner"></view>
      <text>解析中，请稍候…</text>
    </view>
    <text wx:else>解析视频</text>
    <view wx:if="{{parsing}}" class="shimmer"></view>
  </button>

  <view class="guide-card">
    <view class="guide-title">如何获取链接</view>

    <view class="way">
      <view class="way-label">方式 1 · B站视频点分享 → 复制链接</view>
      <view class="share-demo">
        <view class="share-head">分享</view>
        <view class="share-row">
          <view class="share-item">
            <view class="share-ic wx">微</view>
            <text class="share-name">微信</text>
          </view>
          <view class="share-item">
            <view class="share-ic pyq">圈</view>
            <text class="share-name">朋友圈</text>
          </view>
          <view class="share-item on">
            <view class="share-ic">🔗</view>
            <text class="share-name">复制链接</text>
          </view>
          <view class="share-item">
            <view class="share-ic">⋯</view>
            <text class="share-name">更多</text>
          </view>
        </view>
        <view class="share-arrow">↑</view>
      </view>
    </view>

    <view class="way" wx:if="{{showRobotGuide}}">
      <view class="way-label">方式 2 · @小破站私藏</view>
      <view class="guide-steps">
        <view class="guide-step">① B站评论@小破站私藏</view>
        <view class="guide-step">② 进收藏夹查看视频</view>
      </view>
      <view class="demo">
        <view class="demo-video">
          <view class="demo-cover">
            <view class="demo-play">▶</view>
            <text class="demo-dur">13:24</text>
          </view>
          <view class="demo-vmeta">
            <view class="demo-title">一口气看懂《三体》黑暗森林</view>
            <view class="demo-sub">木鱼水心 · 45.2万播放</view>
          </view>
        </view>
        <view class="demo-comment">
          <view class="demo-avatar"></view>
          <view class="demo-cbody">
            <text class="demo-cname">我</text>
            <text class="demo-ctext highlight">@小破站私藏</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="home-footer-note">仅收藏整理视频信息，不存储视频，版权归原作者，请尊重原创</view>
</view>
