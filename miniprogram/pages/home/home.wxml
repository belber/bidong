<custom-navbar />

<view class="page">
  <view class="input-box {{parsing ? 'scanning' : ''}}">
    <image class="lk-icon" src="/images/icon-link.png" mode="aspectFit" />
    <textarea
      class="input"
      placeholder="{{demoPlaceholder}}"
      placeholder-class="ph"
      value="{{input}}"
      bindinput="onInput"
      maxlength="200"
    />
    <text class="paste" bindtap="onPaste">粘贴</text>
    <text class="plat-chip {{platform === 'douyin' ? 'dy' : ''}}" wx:if="{{platform}}">识别到 {{platformLabel}}</text>
  </view>

  <button class="btn-primary parse-btn {{parsing ? 'parsing' : ''}}" bindtap="onParse">
    <view wx:if="{{parsing}}" class="parse-loading">
      <view class="spinner"></view>
      <text>解析中，请稍候…</text>
    </view>
    <block wx:else>
      <text class="parse-main">解析视频</text>
      <text class="parse-sub">B站 · 抖音 视频下载与提取</text>
    </block>
    <view wx:if="{{parsing}}" class="shimmer"></view>
  </button>
  <view class="parse-tip">粘贴链接即可下载、提取视频，音频和封面也能保存到手机</view>

  <view class="guide-card">
    <view class="guide-header" bindtap="onToggleGuide">
      <view class="guide-title">如何获取链接</view>
      <text class="guide-toggle">{{guideExpanded ? '收起' : '展开'}}</text>
    </view>
    <view class="guide-summary" wx:if="{{!guideExpanded}}">分享 → 复制链接，或 B站评论 @壁咚咚私藏</view>

    <block wx:if="{{guideExpanded}}">
    <view class="way">
      <view class="way-label">方式 1 · 分享 → 复制链接（支持 B站、抖音）</view>
      <view class="share-demo">
        <view class="share-head">分享</view>
        <view class="share-row">
          <view class="share-item">
            <view class="share-ic wx">微</view>
            <text class="share-name">微信</text>
          </view>
          <view class="share-item">
            <view class="share-ic pyq">圈</view>
            <text class="share-name">朋友圈</text>
          </view>
          <view class="share-item on">
            <view class="share-ic">🔗</view>
            <text class="share-name">复制链接</text>
          </view>
          <view class="share-item">
            <view class="share-ic">⋯</view>
            <text class="share-name">更多</text>
          </view>
        </view>
        <view class="share-arrow">↑</view>
      </view>
    </view>

    <view class="way" wx:if="{{showRobotGuide}}">
      <view class="way-label">方式 2 · B站评论 @壁咚咚私藏（仅支持 B站）</view>
      <view class="guide-steps">
        <view class="guide-step"><text class="n">1</text>关注B站用户 壁咚咚私藏</view>
        <text class="step-arrow">›</text>
        <view class="guide-step"><text class="n">2</text>评论 @壁咚咚私藏</view>
        <text class="step-arrow">›</text>
        <view class="guide-step"><text class="n">3</text>进收藏夹</view>
      </view>
      <view class="demo">
        <view class="demo-comment">
          <view class="demo-avatar"></view>
          <view class="demo-cbody">
            <text class="demo-cname">我</text>
            <text class="demo-ctext highlight">@壁咚咚私藏</text>
          </view>
        </view>
      </view>
    </view>
    </block>
  </view>

  <view class="ad-banner" wx:if="{{!homeAdError}}">
    <ad unit-id="{{homeAdUnitId}}" binderror="onHomeAdError" />
  </view>

  <view class="home-footer-note">仅收藏整理视频信息，不存储视频，版权归原作者，请尊重原创</view>
</view>
