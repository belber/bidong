.page {
  padding: 20rpx 28rpx 60rpx;
  background: #FFFFFF;
  min-height: calc(100vh - 176rpx);
}

.page.editing {
  padding-bottom: 150rpx;
}

.seg {
  display: flex;
  background: #FFF4F7;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-it {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #B28B97;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-weight: 600;
}

.seg-it.on {
  background: #FB7299;
  color: #FFFFFF;
  font-weight: 700;
}

.tag-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.tag-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.robot-records-tip {
  margin: 32rpx 4rpx 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2B1E23;
}

.guide-card {
  margin-top: 32rpx;
  padding: 30rpx;
  background: #FFFDFE;
  border: 3rpx dashed #F0C9D4;
  border-radius: 22rpx;
}

.guide-title {
  text-align: center;
  font-size: 30rpx;
  color: #B28B97;
  letter-spacing: 0.06em;
  margin-bottom: 18rpx;
}

.guide-steps {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx 16rpx;
  margin-bottom: 18rpx;
}

.guide-step {
  font-size: 28rpx;
  color: #7A6A70;
}

.demo {
  background: #F6F7F8;
  border-radius: 14rpx;
  padding: 16rpx;
}

.demo-video {
  display: flex;
  gap: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #E5E6EB;
}

.demo-cover {
  position: relative;
  width: 150rpx;
  height: 88rpx;
  border-radius: 10rpx;
  flex: none;
  background: linear-gradient(135deg, #1b2440, #4a3f8f);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.demo-play {
  font-size: 30rpx;
}

.demo-dur {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.demo-vmeta {
  flex: 1;
  min-width: 0;
}

.demo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B1E23;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.demo-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9499A0;
}

.demo-comment {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
  border-radius: 10rpx;
  padding: 12rpx;
}

.demo-avatar {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  flex: none;
  background: linear-gradient(135deg, #FB7299, #ff9db9);
}

.demo-cbody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.demo-cname {
  font-size: 20rpx;
  color: #9499A0;
}

.demo-ctext {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #2B1E23;
}

.demo-ctext.highlight {
  color: #FB7299;
  font-weight: 700;
}

.month {
  margin-top: 28rpx;
}

.month-head {
  display: flex;
  align-items: baseline;
  padding: 0 4rpx 12rpx;
}

.month-y {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: #2B1E23;
  font-weight: 700;
}

.month-c {
  font-size: 22rpx;
  color: #B28B97;
  margin-left: auto;
}

.card {
  display: flex;
  gap: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #F7E4EA;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(251, 114, 153, 0.05);
  position: relative;
  margin-bottom: 16rpx;
}

.thumb {
  position: relative;
  width: 208rpx;
  height: 128rpx;
  border-radius: 14rpx;
  flex: none;
  overflow: hidden;
  background: #ECEFF3;
}

.thumb-img {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.src {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #FB7299;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
}

.src.bot {
  background: #3A3A45;
}

.dur {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.68);
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-family: ui-monospace, Menlo, monospace;
}

.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.t {
  font-size: 28rpx;
  font-weight: 650;
  color: #2B1E23;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sub {
  font-size: 24rpx;
  color: #B28B97;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.chips .chip {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}

.check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #E5D7DB;
  align-self: center;
  box-sizing: border-box;
}

.check.on {
  position: relative;
  border-color: #FB7299;
  background: #FB7299;
}

.check.on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 10rpx;
  height: 20rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.edit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F7E4EA;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
}

.edit-count {
  font-size: 28rpx;
  color: #2B1E23;
  font-weight: 650;
}

.edit-actions {
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.edit-btn {
  font-size: 28rpx;
  color: #7A6A70;
}

.edit-btn.danger {
  color: #FFFFFF;
  background: #FB7299;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin: 20rpx 0 32rpx;
  font-size: 28rpx;
  color: #B28B97;
}

.empty-btn {
  width: 360rpx;
}
