.page {
  padding: 20rpx 28rpx 60rpx;
  background: #FFFFFF;
  height: calc(100vh - 176rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 列表用 scroll-view 承载：enhanced + show-scrollbar=false 双端隐藏滚动条 */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-spacer {
  height: calc(env(safe-area-inset-bottom) + 160rpx);
}

.page.editing {
  padding-bottom: 150rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 84rpx;
  padding: 0 24rpx;
  background: #FFF4F7;
  border-radius: 999rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #B28B97;
  flex: none;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #2B1E23;
}

.search-ph {
  color: #C4A6AF;
}

.search-clear {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: #E5D7DB;
  color: #FFFFFF;
  font-size: 28rpx;
}

.filter-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

/* 视图切换行：分区筛选下方独立一行，图标组居中。
   列数不在这行里：改由双指捏合调整（见 pinchZoom.js），行内只有一个图标组 */
.view-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 52rpx;
  margin-top: 16rpx;
}

.vseg {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  background: #FFF4F7;
  border-radius: 16rpx;
}

.vbtn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 44rpx;
  border-radius: 12rpx;
  color: #B28B97;
}

/* 视觉尺寸保持很小，但把可点区域上下各撑 16rpx（约 76rpx ≈ 38pt），避免手指按不准 */
.vbtn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -16rpx;
  bottom: -16rpx;
}

.vbtn.on {
  background: #FFFFFF;
  color: #FB7299;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.vi-list {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 28rpx;
  height: 22rpx;
}

.vi-list .bar {
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.vi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  width: 26rpx;
  height: 26rpx;
}

.vi-grid .q {
  width: 11rpx;
  height: 11rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.guide-card {
  margin-top: 32rpx;
  padding: 30rpx;
  background: #FFFDFE;
  border: 3rpx dashed #F0C9D4;
  border-radius: 22rpx;
}

.guide-title {
  text-align: center;
  font-size: 30rpx;
  color: #B28B97;
  letter-spacing: 0.06em;
  margin-bottom: 18rpx;
}

.guide-steps {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx 16rpx;
  margin-bottom: 18rpx;
}

.guide-step {
  font-size: 28rpx;
  color: #7A6A70;
}

.demo {
  background: #F6F7F8;
  border-radius: 14rpx;
  padding: 16rpx;
}

.demo-video {
  display: flex;
  gap: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #E5E6EB;
}

.demo-cover {
  position: relative;
  width: 150rpx;
  height: 88rpx;
  border-radius: 10rpx;
  flex: none;
  background: linear-gradient(135deg, #1b2440, #4a3f8f);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.demo-play {
  font-size: 30rpx;
}

.demo-dur {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.demo-vmeta {
  flex: 1;
  min-width: 0;
}

.demo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B1E23;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.demo-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9499A0;
}

.demo-comment {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
  border-radius: 10rpx;
  padding: 12rpx;
}

.demo-avatar {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  flex: none;
  background: linear-gradient(135deg, #FB7299, #ff9db9);
}

.demo-cbody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.demo-cname {
  font-size: 20rpx;
  color: #9499A0;
}

.demo-ctext {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #2B1E23;
}

.demo-ctext.highlight {
  color: #FB7299;
  font-weight: 700;
}

.month {
  margin-top: 28rpx;
}

.month-head {
  display: flex;
  align-items: baseline;
  padding: 0 4rpx 12rpx;
}

.month-y {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: #2B1E23;
  font-weight: 700;
}

.month-c {
  font-size: 22rpx;
  color: #B28B97;
  margin-left: auto;
}

.card {
  display: flex;
  gap: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #F7E4EA;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(251, 114, 153, 0.05);
  position: relative;
  margin-bottom: 16rpx;
}

.thumb {
  position: relative;
  width: 208rpx;
  height: 128rpx;
  border-radius: 14rpx;
  flex: none;
  overflow: hidden;
  background: #ECEFF3;
}

.thumb-img {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.dur {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.68);
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-family: ui-monospace, Menlo, monospace;
}

.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.t {
  font-size: 28rpx;
  font-weight: 650;
  color: #2B1E23;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sub {
  font-size: 24rpx;
  color: #B28B97;
}

/* 网格视图：列数由 cols-N 控制；卡片沿用列表的信息层级，只是改成纵向排布 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 18rpx;
}

.grid.cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.grid.cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.gcell {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.gthumb {
  position: relative;
  width: 100%;
  padding-top: 62.5%; /* 16:10，与列表缩略图同一比例 */
  border-radius: 16rpx;
  overflow: hidden;
  background: #ECEFF3;
}

.gthumb .dur {
  right: 8rpx;
  bottom: 8rpx;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
}

/* 编辑态勾选圈落封面左上角（来源角标去掉后空出来的位置，右上角留给平台角标） */
.gthumb .check {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
}

.gt {
  font-size: 26rpx;
  font-weight: 650;
  color: #2B1E23;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.gsub {
  font-size: 20rpx;
  color: #B28B97;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 网格卡片只留封面 + 标题 + UP主·分区：标签不进网格（列表里仍保留），
   4 列时连 UP主·分区 也放不下，只剩标题 */
.grid.cols-4 .gsub {
  display: none;
}

.check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #E5D7DB;
  align-self: center;
  box-sizing: border-box;
}

.check.on {
  position: relative;
  border-color: #FB7299;
  background: #FB7299;
}

.check.on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 10rpx;
  height: 20rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.edit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F7E4EA;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 110;
}

.edit-count {
  font-size: 28rpx;
  color: #2B1E23;
  font-weight: 650;
}

.edit-actions {
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.edit-btn {
  font-size: 28rpx;
  color: #7A6A70;
}

.edit-btn.danger {
  color: #FFFFFF;
  background: #FB7299;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin: 20rpx 0 32rpx;
  font-size: 28rpx;
  color: #B28B97;
}

.empty-btn {
  width: 360rpx;
}

/* 平台角标：封面右上角（来源角标已去掉，左下/左上留给时长与编辑态勾选圈） */
.plat {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #FB7299;
}

.plat.dy {
  background: #161823;
}

.ad-slot {
  margin: 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 网格下的广告：贴在月份分组末尾的整行横幅（不参与网格排版，所以不会空出半格） */
.ad-banner {
  margin: 16rpx 0 0;
}
