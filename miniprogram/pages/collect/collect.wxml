<custom-navbar />

<view class="page">
  <view class="seg">
    <view class="seg-it {{sourceFilter === 'all' ? 'on' : ''}}" data-source="all" bindtap="onSourceTap">全部</view>
    <view class="seg-it {{sourceFilter === 'local' ? 'on' : ''}}" data-source="local" bindtap="onSourceTap">本机</view>
    <view class="seg-it {{sourceFilter === 'robot' ? 'on' : ''}}" data-source="robot" bindtap="onSourceTap">@壁咚</view>
  </view>

  <scroll-view class="tag-scroll" wx:if="{{!showRobotGuide}}" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tag-inner">
      <text class="chip {{tagFilter === item ? 'chip-on' : ''}}" wx:for="{{allTags}}" wx:key="*this" data-tag="{{item}}" bindtap="onTagTap">{{item}}</text>
    </view>
  </scroll-view>

  <block wx:if="{{showRobotGuide}}">
    <view class="guide-card">
      <view class="guide-title">你还未绑定或未 @过，可以按下面的方式操作</view>
      <view class="guide-steps">
        <view class="guide-step">① 关注 @壁咚收藏</view>
        <view class="guide-step">② 评论区 @壁咚收藏</view>
        <view class="guide-step">③ 视频自动解析进收藏夹查看</view>
      </view>
      <view class="demo">
        <view class="demo-video">
          <view class="demo-cover">
            <view class="demo-play">▶</view>
            <text class="demo-dur">13:24</text>
          </view>
          <view class="demo-vmeta">
            <view class="demo-title">一口气看懂《三体》黑暗森林</view>
            <view class="demo-sub">木鱼水心 · 45.2万播放</view>
          </view>
        </view>
        <view class="demo-comment">
          <view class="demo-avatar"></view>
          <view class="demo-cbody">
            <text class="demo-cname">我</text>
            <text class="demo-ctext highlight">@壁咚收藏</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="robot-records-tip" wx:if="{{sourceFilter === 'robot'}}">你 @过的内容如下</view>
    <block wx:if="{{groups.length}}">
      <view class="month" wx:for="{{groups}}" wx:key="month" wx:for-item="group">
        <view class="month-head">
          <text class="month-y">● {{group.month}}</text>
          <text class="month-c">{{group.count}} 个视频</text>
        </view>
        <view
          class="card"
          wx:for="{{group.items}}"
          wx:key="id"
          wx:for-item="card"
          bindtap="onCardTap"
          data-id="{{card.id}}"
        >
          <view class="thumb" style="background: {{card.cover_gradient}}">
            <text class="src {{card.source === 'robot' ? 'bot' : ''}}">{{card.source === 'robot' ? '@壁咚' : '本机'}}</text>
            <text class="dur">{{card.dur}}</text>
          </view>
          <view class="meta">
            <view class="t">{{card.title}}</view>
            <view class="sub">{{card.up_name}} · {{card.partition}}</view>
            <view class="chips">
              <text class="chip chip-tag" wx:for="{{card.tags}}" wx:key="*this">＃{{item}}</text>
            </view>
          </view>
          <view class="del" catchtap="onDelete" data-id="{{card.id}}">⋯</view>
        </view>
      </view>
    </block>

    <view class="empty" wx:else>
      <view class="empty-icon">🗂</view>
      <view class="empty-text">还没有符合条件的收藏</view>
      <button class="btn-primary empty-btn" bindtap="onGotoParse">＋ 去解析</button>
    </view>
  </block>
</view>
