<custom-navbar />

<view class="page {{editing ? 'editing' : ''}}">
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索标题 / UP主 / 分区 / 标签"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onKeywordInput"
    />
    <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</text>
  </view>

  <view class="seg">
    <view class="seg-it {{sourceFilter === 'all' ? 'on' : ''}}" data-source="all" bindtap="onSourceTap">全部</view>
    <view class="seg-it {{sourceFilter === 'local' ? 'on' : ''}}" data-source="local" bindtap="onSourceTap">本机</view>
    <view class="seg-it {{sourceFilter === 'robot' ? 'on' : ''}}" data-source="robot" bindtap="onSourceTap">@壁咚</view>
  </view>

  <scroll-view class="filter-scroll" wx:if="{{!showRobotGuide}}" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-inner">
      <text class="chip {{partitionFilter === item ? 'chip-on' : ''}}" wx:for="{{allPartitions}}" wx:key="*this" data-partition="{{item}}" bindtap="onPartitionTap">{{item}}</text>
    </view>
  </scroll-view>

  <block wx:if="{{showRobotGuide}}">
    <view class="guide-card">
      <view class="guide-title">你还未绑定或未 @过，可以按下面的方式操作</view>
      <view class="guide-steps">
        <view class="guide-step">① B站评论区 @壁咚收藏</view>
        <view class="guide-step">② 进收藏夹查看视频</view>
      </view>
      <view class="demo">
        <view class="demo-video">
          <view class="demo-cover">
            <view class="demo-play">▶</view>
            <text class="demo-dur">13:24</text>
          </view>
          <view class="demo-vmeta">
            <view class="demo-title">一口气看懂《三体》黑暗森林</view>
            <view class="demo-sub">木鱼水心 · 45.2万播放</view>
          </view>
        </view>
        <view class="demo-comment">
          <view class="demo-avatar"></view>
          <view class="demo-cbody">
            <text class="demo-cname">我</text>
            <text class="demo-ctext highlight">@壁咚收藏</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="robot-records-tip" wx:if="{{sourceFilter === 'robot'}}">你 @过的内容如下</view>
    <block wx:if="{{groups.length}}">
      <view class="month" wx:for="{{groups}}" wx:key="month" wx:for-item="group">
        <view class="month-head">
          <text class="month-y">● {{group.month}}</text>
          <text class="month-c">{{group.count}} 个视频</text>
        </view>
        <view
          class="card"
          wx:for="{{group.items}}"
          wx:key="id"
          wx:for-item="card"
          bindtap="onCardTap"
          bindlongpress="onCardLongPress"
          data-id="{{card.id}}"
        >
          <view wx:if="{{editing}}" class="check {{card.selected ? 'on' : ''}}"></view>
          <view class="thumb">
            <image class="thumb-img" src="{{card.cover_url}}" mode="aspectFill" />
            <text class="src {{card.source === 'robot' ? 'bot' : ''}}">{{card.source === 'robot' ? '@壁咚' : '本机'}}</text>
            <text class="dur">{{card.dur}}</text>
          </view>
          <view class="meta">
            <view class="t">{{card.title}}</view>
            <view class="sub">{{card.up_name}} · {{card.partition}}</view>
            <view class="chips">
              <text class="chip chip-tag" wx:for="{{card.tags}}" wx:key="*this">＃{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="empty" wx:else>
      <view class="empty-icon">🗂</view>
      <view class="empty-text">{{keyword ? '没有找到相关收藏' : '还没有符合条件的收藏'}}</view>
      <button class="btn-primary empty-btn" bindtap="onGotoParse">＋ 去解析</button>
    </view>
  </block>

  <view class="edit-bar" wx:if="{{editing}}">
    <text class="edit-count">已选 {{selectedCount}} 项</text>
    <view class="edit-actions">
      <text class="edit-btn" bindtap="onSelectAll">全选</text>
      <text class="edit-btn" bindtap="onCancelEdit">取消</text>
      <text class="edit-btn danger" bindtap="onDeleteSelected">删除</text>
    </view>
  </view>
</view>
