.page {
  padding: 32rpx 28rpx 60rpx;
  background: #FFFFFF;
  min-height: calc(100vh - 176rpx);
}

.bind {
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
}

.bind-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bind-t {
  font-size: 34rpx;
  font-weight: 750;
  color: #2B1E23;
}

.steps {
  font-size: 28rpx;
  color: #7A6A70;
  line-height: 1.8;
}

.bind-btn {
  margin-top: 28rpx;
  border-radius: 20rpx;
}

.chip-ok {
  background: #E8F6EC;
  color: #2E9E5B;
  font-weight: 600;
}

.unbind-row {
  margin-top: 16rpx;
  text-align: right;
}

.unbind-link {
  font-size: 26rpx;
  color: #B28B97;
  padding: 12rpx 4rpx;
}

.menu {
  margin-top: 32rpx;
  padding: 0;
  overflow: hidden;
}

.mi {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx;
  font-size: 32rpx;
  color: #2B1E23;
  font-weight: 550;
  border-bottom: 1rpx solid #FBF0F3;
}

.mi:last-child {
  border-bottom: none;
}

.arr {
  font-size: 34rpx;
  color: #C9A6B1;
}
