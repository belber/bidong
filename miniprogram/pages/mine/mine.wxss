.page {
  /* 底部留出 Tab 栏（约 148rpx）+ 安全区的高度：最后一条广告不贴在 Tab 栏上 */
  padding: 32rpx 28rpx calc(env(safe-area-inset-bottom) + 220rpx);
  background: #FFFFFF;
  min-height: calc(100vh - 176rpx);
}

.bind {
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
}

.bind-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bind-t {
  font-size: 34rpx;
  font-weight: 750;
  color: #2B1E23;
}

.head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unbind-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FCEAF0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unbind-glyph {
  font-size: 26rpx;
  color: #B28B97;
  line-height: 1;
}

.steps {
  font-size: 28rpx;
  color: #7A6A70;
  line-height: 1.8;
}

.bind-btn {
  margin-top: 28rpx;
  border-radius: 20rpx;
}

.chip-ok {
  background: #E8F6EC;
  color: #2E9E5B;
  font-weight: 600;
}

.menu {
  margin-top: 32rpx;
  padding: 0;
  overflow: hidden;
}

.mi {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx;
  font-size: 32rpx;
  color: #2B1E23;
  font-weight: 550;
  border-bottom: 1rpx solid #FBF0F3;
}

.mi:last-child {
  border-bottom: none;
}

.arr {
  font-size: 34rpx;
  color: #C9A6B1;
}

.ad-banner {
  /* 我的页左右 padding 28rpx，按 20:7 预留固定高度 */
  width: calc(100vw - 56rpx);
  height: calc((100vw - 56rpx) * 7 / 20);
  margin: 32rpx 0 0;
  border-radius: 16rpx;
  overflow: hidden;
}
