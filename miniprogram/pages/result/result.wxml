<view class="page">
  <view class="visitor-tip" wx:if="{{publicView}}">以访客身份查看 · 登录后才能下载与导出</view>

  <view class="card video-summary">
    <view class="summary-cover">
      <image wx:if="{{coverUrl && !coverFailed}}" class="summary-thumbnail" src="{{coverUrl}}" mode="aspectFill" bindtap="onPreviewCover" binderror="onCoverError" />
      <view wx:else class="summary-placeholder"><view class="media-item-icon icon-video"></view><text>暂无封面</text></view>
    </view>
    <view class="summary-copy"><view class="summary-title">{{title || '无标题'}}</view>
    <view class="summary-author">{{upName || '未知作者'}}</view></view>
  </view>

  <!-- 帅哥录屏专属：只有该账号的稿件，后端才会返回 origin -->
  <view class="card source-card" wx:if="{{origin}}">
    <view class="sec-title">
      <text class="bar"></text>
      <image wx:if="{{origin.accountAvatarUrl}}" class="src-avatar" src="{{origin.accountAvatarUrl}}" mode="aspectFill" />
      <text>{{origin.accountName}} · 原up主是谁</text>
      <text class="push"></text>
      <text class="fan-chip">粉丝专属</text>
    </view>

    <view class="field">
      <text class="label">原平台</text>
      <view class="content {{origin.platformText === '—' ? 'muted' : ''}}">{{origin.platformText}}</view>
    </view>

    <view class="field">
      <text class="label">原up主</text>
      <view class="content {{origin.hasAuthor ? '' : 'muted'}}">{{origin.authorText}}</view>
      <text class="action" wx:if="{{origin.hasAuthor}}" bindtap="onCopyAuthorName">复制原up账号</text>
    </view>

    <view class="src-hint" wx:if="{{origin.pending}}">这条的出处还在整理，稍后再来看看</view>
  </view>


  <view class="card media-download-card">
    <view class="section-heading"><view class="section-icon icon-download" aria-hidden="true"></view><text>媒体下载</text></view>
    <view class="media-empty" wx:if="{{publicView || (!hasMediaDownloads && !isNote)}}">{{publicView ? '登录后可查看下载选项' : '当前暂无可用下载项'}}</view>
    <view class="media-hint" wx:if="{{isDouyin && isNote && !publicView}}">抖音图文作品：{{imageCount ? imageCount + ' 张图片' : '图片'}}和音频需要分开下载</view>
    <view class="field export-field download-field media-row" wx:if="{{(isDouyin ? media.clean : media.watermarked) && !publicView}}">
      <view class="media-item-main">
        <view class="media-item-icon icon-video" aria-hidden="true"></view>
        <view class="media-item-copy"><view class="media-item-line"><text class="media-item-name">视频下载</text><text class="media-item-size" wx:if="{{mediaSize.video}}">（{{mediaSize.video}}）</text></view>

        </view>
      </view>
      <text class="action download-btn {{downloading ? 'disabled' : ''}}" bindtap="onUnifiedVideoTap" data-kind="video">{{downloading && (activeKind === 'video' || activeKind === 'watermarked') ? downloadProgress + '%' : '下载'}}</text>
      <view class="export-progress" wx:if="{{downloading && (activeKind === 'video' || activeKind === 'watermarked')}}">
        <view class="export-track"><view class="progress-bar" style="width: {{downloadProgress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{downloadSizeText}}">{{downloadSizeText}}</text>
      </view>
    </view>

    <view class="field export-field download-field media-row" wx:if="{{isDouyin && media.audio && !publicView}}">
      <view class="media-item-main">
        <view class="media-item-icon icon-audio" aria-hidden="true"></view>
        <view class="media-item-copy"><view class="media-item-line"><text class="media-item-name">音频</text><text class="media-item-size" wx:if="{{mediaSize.audio}}">（{{mediaSize.audio}}）</text></view><view class="media-item-detail" wx:if="{{!mediaSize.audio}}">原声 / BGM</view></view>
      </view>
      <text
        class="action download-btn {{exports.audio.state === 'downloading' ? 'disabled' : exports.audio.state === 'ready' ? 'primary' : ''}}"
        bindtap="onExportTap"
        data-kind="audio"
      >{{exports.audio.state === 'downloading' ? exports.audio.progress + '%' : exports.audio.state === 'ready' ? '保存' : exports.audio.state === 'saved' ? '再次保存' : exports.audio.state === 'failed' ? '重试' : '下载'}}</text>
      <view class="export-progress" wx:if="{{exports.audio.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.audio.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.audio.sizeText}}">{{exports.audio.sizeText}}</text>
      </view>

    </view>

    <!-- 抖音图集：图片与音频分开保存 -->
    <view class="field media-row" wx:if="{{isDouyin && isNote && !imageCount}}">
      <view class="media-item-main"><view class="media-item-icon icon-images" aria-hidden="true"></view><view class="media-item-copy"><text class="media-item-name">图片</text><view class="media-item-detail">这是抖音图文作品，图片暂不支持保存</view></view></view>
    </view>
    <view class="field export-field download-field media-row" wx:if="{{isDouyin && imageCount && !publicView}}">
      <view class="media-item-main">
        <view class="media-item-icon icon-images" aria-hidden="true"></view>
        <view class="media-item-copy"><view class="media-item-line"><text class="media-item-name">图片</text><text class="media-item-size">（共 {{imageCount}} 张）</text></view></view>
      </view>
      <text
        class="action download-btn {{savingImages ? 'disabled' : ''}}"
        bindtap="onSaveImages"
      >{{savingImages ? '保存中' : '保存全部'}}</text>
      <view class="export-progress" wx:if="{{savingImages}}">
        <view class="export-track"><view class="progress-bar" style="width: {{imagePercent}}%"></view></view>
        <text class="export-progress-text">{{imageStatus || '正在保存…'}}</text>
      </view>

    </view>

    <view class="field export-field download-field media-row" wx:if="{{!isDouyin && media.audio && !publicView}}">
      <view class="media-item-main">
        <view class="media-item-icon icon-audio" aria-hidden="true"></view>
        <view class="media-item-copy"><view class="media-item-line"><text class="media-item-name">音频</text><text class="media-item-size" wx:if="{{mediaSize.audio && !audioUnavailable}}">（{{mediaSize.audio}}）</text></view><view class="media-item-detail" wx:if="{{audioUnavailable}}">这条视频没有单独的音轨，下载上面的「视频」即可（视频里含声音）</view></view>
      </view>
      <text
        wx:if="{{!audioUnavailable}}"
        class="action download-btn {{exports.audio.state === 'downloading' ? 'disabled' : exports.audio.state === 'ready' ? 'primary' : ''}}"
        bindtap="onExportTap"
        data-kind="audio"
      >{{exports.audio.state === 'downloading' ? exports.audio.progress + '%' : exports.audio.state === 'ready' ? '保存' : exports.audio.state === 'saved' ? '再次保存' : exports.audio.state === 'failed' ? '重试' : '下载'}}</text>
      <view class="export-progress" wx:if="{{exports.audio.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.audio.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.audio.sizeText}}">{{exports.audio.sizeText}}</text>
      </view>

    </view>

    <view class="field media-download-status" wx:if="{{downloading && !isDouyin && !publicView}}">
      <view class="content"><view class="progress-wrap"><view class="progress-bar" style="width: {{downloadProgress}}%"></view></view><text class="progress-text">{{downloadProgress}}%{{downloadSizeText}}</text></view>
    </view>
  </view>

  <view class="card transcript-card" wx:if="{{!publicView && !isNote}}">
    <view class="transcript-header">
    <view class="section-heading"><view class="section-icon icon-document" aria-hidden="true"></view><text>视频文案</text></view>
      <button class="transcript-button" bindtap="onTranscriptTap" disabled="{{transcript.busy || transcriptSubmitting || transcript.status === 'no_speech'}}"><text>{{transcriptSubmitting ? '提交中' : transcript.button}}</text><view wx:if="{{transcript.status === 'completed'}}" class="transcript-chevron" aria-hidden="true"></view></button>
    </view>
    <view class="transcript-action-row" wx:if="{{transcript.status !== 'idle' || transcriptSubmitting}}">
      <view class="transcript-status">
        <view class="transcript-status-icon status-{{transcript.status}} {{transcriptSubmitting ? 'is-submitting' : ''}}" aria-hidden="true"></view>
        <view class="transcript-status-copy">
          <view class="transcript-state">{{transcriptSubmitting ? '正在提交' : transcript.statusTitle}}</view>
          <view class="transcript-meta" wx:if="{{transcript.status === 'completed'}}"><text wx:if="{{transcript.languageText}}">识别语言：{{transcript.languageText}}<text class="meta-divider"> | </text></text><text>时长：{{durationText}}</text></view>
          <view class="transcript-hint" wx:else>{{transcript.statusHint}}</view>
        </view>
      </view>
    </view>
    <view class="transcript-read-error" wx:if="{{transcriptReadError}}">{{transcriptReadError}}</view>
  </view>

  <view class="card more-info">
    <view class="more-toggle" bindtap="onToggleMoreInfo" role="button" aria-expanded="{{moreInfoExpanded}}">
      <text>更多信息</text><text class="more-arrow">{{moreInfoExpanded ? '收起 ⌃' : '展开 ⌄'}}</text>
    </view>
    <view wx:if="{{moreInfoExpanded}}" class="more-content">
  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>基本信息</text></view>

    <view class="field">
      <text class="label">标题</text>
      <view class="content title">{{title || '无标题'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="title">复制</text>
    </view>

    <view class="field">
      <text class="label">up主</text>
      <view class="content">{{upName || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="upName">复制</text>
    </view>

    <view class="field" wx:if="{{!isDouyin}}">
      <text class="label">分区</text>
      <view class="content">{{partition || '未知'}}</view>
    </view>

    <view class="field" wx:else>
      <text class="label">抖音号</text>
      <view class="content">{{douyinId || '未知'}}</view>
      <text class="action" wx:if="{{douyinId}}" bindtap="onCopyTag" data-field="douyinId">复制</text>
    </view>

    <view class="field">
      <text class="label">发布时间</text>
      <view class="content">{{pubText || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="pubText">复制</text>
    </view>

    <view class="field">
      <text class="label">标签</text>
      <view class="content {{tagsLong && !tagsExpanded ? 'clamp-2' : ''}}"><text wx:if="{{tagsText}}">{{tagsText}}</text><text wx:else class="muted">无标签</text></view>
      <view class="ops">
        <text class="action" wx:if="{{tagsLong}}" bindtap="onToggleField" data-field="tags">{{tagsExpanded ? '收起' : '展开'}}</text>
        <text class="action" bindtap="onCopyTag" data-field="tags">复制</text>
      </view>
    </view>

    <view class="field">
      <text class="label">简介</text>
      <view class="content {{descLong && !descExpanded ? 'clamp-2' : ''}}">{{desc || '无简介'}}</view>
      <view class="ops">
        <text class="action" wx:if="{{descLong}}" bindtap="onToggleField" data-field="desc">{{descExpanded ? '收起' : '展开'}}</text>
        <text class="action" bindtap="onCopyTag" data-field="desc">复制</text>
      </view>
    </view>
  </view>


  <view class="card">
    <view class="field">
      <text class="label">封面</text>
      <view class="content">
        <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="aspectFill" bindtap="onPreviewCover" bindlongpress="onSaveCover" />
        <text wx:else class="muted">无封面</text>
      </view>
    </view>

  </view>
  <view class="card" wx:if="{{!publicView && (subtitles.length || !isDouyin)}}">
    <view class="sec-title"><text class="bar"></text><text>文本</text></view>

    <view class="field export-field" wx:if="{{subtitles.length}}">
      <text class="label">字幕</text>
      <view class="content" wx:if="{{subtitles.length}}">
        <view wx:for="{{showAllSub ? subtitles : subPreview}}" wx:key="t" class="sub">{{item.timeText}} {{item.text}}</view>
        <view class="ops">
          <text class="action" bindtap="onToggleSub">{{showAllSub ? '收起' : '展开'}}</text>
          <text class="action" bindtap="onCopySub">复制</text>
          <text
            class="action {{exports.subtitle.state === 'downloading' ? 'disabled' : exports.subtitle.state === 'ready' ? 'primary' : ''}}"
            bindtap="onExportTap"
            data-kind="subtitle"
          >{{exports.subtitle.state === 'downloading' ? exports.subtitle.progress + '%' : exports.subtitle.state === 'ready' ? '保存' : exports.subtitle.state === 'saved' ? '再次保存' : exports.subtitle.state === 'failed' ? '重试' : '下载'}}</text>
        </view>
      </view>
      <view class="export-progress" wx:if="{{exports.subtitle.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.subtitle.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.subtitle.sizeText}}">{{exports.subtitle.sizeText}}</text>
      </view>
    </view>

    <view class="field export-field" wx:if="{{!isDouyin && features.danmaku}}">
      <text class="label">弹幕</text>
      <view class="content" wx:if="{{danmakuCount}}">共 {{danmakuCount}} 条</view>
      <view class="content muted" wx:else>无弹幕</view>
      <view class="ops" wx:if="{{danmakuCount}}">
        <text
          class="action {{exports.danmaku.state === 'downloading' ? 'disabled' : exports.danmaku.state === 'ready' ? 'primary' : ''}}"
          bindtap="onExportTap"
          data-kind="danmaku"
        >{{exports.danmaku.state === 'downloading' ? exports.danmaku.progress + '%' : exports.danmaku.state === 'ready' ? '保存' : exports.danmaku.state === 'saved' ? '再次保存' : exports.danmaku.state === 'failed' ? '重试' : '下载'}}</text>
      </view>
      <view class="export-progress" wx:if="{{exports.danmaku.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.danmaku.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.danmaku.sizeText}}">{{exports.danmaku.sizeText}}</text>
      </view>
    </view>

    <view class="field export-field" wx:if="{{!isDouyin && features.comment}}">
      <text class="label">评论</text>
      <view class="content" wx:if="{{stats.reply}}">共 {{stats.reply}} 条</view>
      <view class="content muted" wx:else>无评论</view>
      <view class="ops" wx:if="{{stats.reply}}">
        <text
          class="action {{exports.comment.state === 'downloading' ? 'disabled' : exports.comment.state === 'ready' ? 'primary' : ''}}"
          bindtap="onExportTap"
          data-kind="comment"
        >{{exports.comment.state === 'downloading' ? exports.comment.progress + '%' : exports.comment.state === 'ready' ? '保存' : exports.comment.state === 'saved' ? '再次保存' : exports.comment.state === 'failed' ? '重试' : '下载'}}</text>
      </view>
      <view class="export-progress" wx:if="{{exports.comment.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.comment.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.comment.sizeText}}">{{exports.comment.sizeText}}</text>
      </view>
    </view>
  </view>

    </view>
  </view>

  <view class="ad-banner" wx:if="{{!resultAdError}}">
    <ad unit-id="{{resultAdUnitId}}" binderror="onResultAdError" />
  </view>

  <view class="bottom-bar">
    <button class="btn-ghost" wx:if="{{shareEnabled}}" open-type="share">分享</button>
    <button class="btn-primary" bindtap="onOpenBili">{{isDouyin ? '去抖音查看' : '去 B站查看'}}</button>
  </view>

  <view wx:if="{{previewing}}" class="preview-mask" bindtap="onClosePreview">
    <image class="preview-img" src="{{coverUrl}}" mode="aspectFit" />
    <view class="preview-save" catchtap="onSaveCover">保存到相册</view>
    <view class="preview-hint">点空白处关闭</view>
  </view>

  <view wx:if="{{fallbackVisible}}" class="preview-mask guide-mask">
    <view class="fallback-card" catchtap="">
      <view class="fallback-close" catchtap="onCloseFallback">✕</view>

      <view class="fallback-title">换一种方式保存</view>
      <view class="fallback-sub">当前视频链接暂不支持在小程序内直接保存</view>
      <view class="fallback-sub">复制链接后，用手机浏览器打开即可保存视频。</view>

      <view class="platform-row">
        <view class="platform-card">
          <view class="platform-head">
            <text class="platform-icon">🍎</text>
            <text class="platform-name">iPhone</text>
          </view>
          <view class="step"><text class="step-idx">1</text><text class="step-txt">复制链接</text></view>
          <view class="step"><text class="step-idx">2</text><text class="step-txt">Safari 打开</text></view>
          <view class="step"><text class="step-idx">3</text><text class="step-txt">保存到「文件」</text></view>
        </view>
        <view class="platform-card">
          <view class="platform-head">
            <text class="platform-icon">🤖</text>
            <text class="platform-name">Android</text>
          </view>
          <view class="step"><text class="step-idx">1</text><text class="step-txt">复制链接</text></view>
          <view class="step"><text class="step-idx">2</text><text class="step-txt">Chrome 打开</text></view>
          <view class="step"><text class="step-idx">3</text><text class="step-txt">点击下载</text></view>
        </view>
      </view>

      <view class="fallback-tip">链接可能有时效，请及时保存</view>
      <button class="btn-primary fallback-button" bindtap="onCopyFallback">复制链接</button>
    </view>
  </view>

  <view wx:if="{{loadingVisible}}" class="countdown-mask">
    <view class="countdown-card">
      <view class="countdown-track"><view class="countdown-bar"></view></view>
      <view class="countdown-text">{{loadingText}}</view>
      <view class="countdown-sub">{{loadingSub}}</view>
    </view>
  </view>

</view>
