<view class="page">
  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>基本信息</text></view>

    <view class="field">
      <text class="label">标题</text>
      <view class="content title">{{title || '无标题'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="title">复制</text>
    </view>

    <view class="field">
      <text class="label">up主</text>
      <view class="content">{{upName || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="upName">复制</text>
    </view>

    <view class="field">
      <text class="label">分区</text>
      <view class="content">{{partition || '未知'}}</view>
    </view>

    <view class="field">
      <text class="label">发布时间</text>
      <view class="content">{{pubText || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="pubText">复制</text>
    </view>

    <view class="field">
      <text class="label">标签</text>
      <view class="content"><text wx:if="{{tagsText}}">{{tagsText}}</text><text wx:else class="muted">无标签</text></view>
      <text class="action" bindtap="onCopyTag" data-field="tags">复制</text>
    </view>

    <view class="field">
      <text class="label">简介</text>
      <view class="content">{{desc || '无简介'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="desc">复制</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>数据</text></view>
    <view class="stats-box">
      <view class="stat"><text class="stat-n">{{stats.like}}</text><text class="stat-l">点赞</text></view>
      <view class="stat"><text class="stat-n">{{stats.reply}}</text><text class="stat-l">评论</text></view>
      <view class="stat"><text class="stat-n">{{stats.favorite}}</text><text class="stat-l">收藏</text></view>
      <view class="stat"><text class="stat-n">{{stats.coin}}</text><text class="stat-l">投币</text></view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>媒体</text></view>

    <view class="field">
      <text class="label">封面</text>
      <view class="content">
        <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="aspectFill" bindtap="onPreviewCover" bindlongpress="onSaveCover" />
        <text wx:else class="muted">无封面</text>
      </view>
    </view>

    <view class="field" wx:if="{{media.watermarked}}">
      <text class="label">视频</text>
      <view class="content muted">{{mediaSize.watermarked || '单文件流，含音频'}}</view>
      <text class="action" bindtap="onDownloadVideo" data-kind="watermarked">下载</text>
    </view>

    <view class="field" wx:if="{{media.clean}}">
      <text class="label">无水印视频</text>
      <view class="content muted">{{mediaSize.clean || '高清视频轨，不含音频'}}</view>
      <text class="action" bindtap="onDownloadVideo" data-kind="clean">下载</text>
    </view>

    <view class="field" wx:if="{{media.audio}}">
      <text class="label">纯音频</text>
      <view class="content muted">{{mediaSize.audio || '音频轨'}}</view>
      <text class="action" bindtap="onDownloadAudio">转发</text>
    </view>

    <!-- 下载进度 -->
    <view class="field" wx:if="{{downloading}}">
      <text class="label">下载中</text>
      <view class="content">
        <view class="progress-wrap">
          <view class="progress-bar" style="width: {{downloadProgress}}%"></view>
        </view>
        <text class="progress-text">{{downloadProgress}}%{{downloadSizeText}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>文本</text></view>

    <view class="field">
      <text class="label">字幕</text>
      <view class="content" wx:if="{{subtitles.length}}">
        <view wx:for="{{showAllSub ? subtitles : subPreview}}" wx:key="t" class="sub">{{item.timeText}} {{item.text}}</view>
        <view class="ops">
          <text class="action" bindtap="onToggleSub">{{showAllSub ? '收起' : '展开'}}</text>
          <text class="action" bindtap="onCopySub">复制</text>
          <text class="action" bindtap="onDownloadSrt">转发</text>
        </view>
      </view>
      <view class="content muted" wx:else>无字幕</view>
    </view>

    <view class="field" wx:if="{{features.danmaku}}">
      <text class="label">弹幕</text>
      <view class="content" wx:if="{{danmakuCount}}">共 {{danmakuCount}} 条</view>
      <view class="content muted" wx:else>无弹幕</view>
      <view class="ops" wx:if="{{danmakuCount}}">
        <text class="action" bindtap="onDownloadDanmaku">转发</text>
      </view>
    </view>

    <view class="field" wx:if="{{features.comment}}">
      <text class="label">评论</text>
      <view class="content" wx:if="{{stats.reply}}">共 {{stats.reply}} 条</view>
      <view class="content muted" wx:else>无评论</view>
      <view class="ops" wx:if="{{stats.reply}}">
        <text class="action" bindtap="onDownloadComments">转发</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-ghost" wx:if="{{shareEnabled}}" open-type="share">分享</button>
    <button class="btn-primary" bindtap="onOpenBili">去 B站查看</button>
  </view>

  <view wx:if="{{previewing}}" class="preview-mask" bindtap="onClosePreview">
    <image class="preview-img" src="{{coverUrl}}" mode="aspectFit" />
    <view class="preview-save" catchtap="onSaveCover">保存到相册</view>
    <view class="preview-hint">点空白处关闭</view>
  </view>

  <view wx:if="{{fallbackVisible}}" class="preview-mask" bindtap="onCloseFallback">
    <view class="fallback-card" catchtap="">
      <view class="fallback-title">下载失败</view>
      <view class="fallback-msg">{{fallbackMessage}}</view>
      <view class="fallback-actions">
        <button class="btn-ghost small" bindtap="onCopyFallback">复制下载链接</button>
        <button class="btn-primary small" bindtap="onShowTutorial">查看保存教程</button>
      </view>
      <view class="fallback-actions">
        <button class="btn-ghost small" bindtap="onRetryDownload">重新解析</button>
        <button class="btn-ghost small" bindtap="onCloseFallback">关闭</button>
      </view>
    </view>
  </view>

  <view wx:if="{{tutorialVisible}}" class="preview-mask" bindtap="onCloseTutorial">
    <view class="tutorial-card" catchtap="">
      <view class="fallback-title">手动保存教程</view>
      <view class="tutorial-body">
        <view class="tutorial-step">1. 复制下载链接；</view>
        <view class="tutorial-step">2. 打开微信，把链接发给「文件传输助手」；</view>
        <view class="tutorial-step">3. 点击链接，在微信内置浏览器中打开；</view>
        <view class="tutorial-step">4. 播放或长按视频，选择「保存视频」；</view>
        <view class="tutorial-step">5. 保存后可在手机相册查看。</view>
        <view class="tutorial-note">链接会过期，复制后请立即使用；若提示链接失效，请重新解析。</view>
        <view class="tutorial-note">Android：没有保存按钮时可长按视频；部分浏览器会先存到「文件管理」。</view>
        <view class="tutorial-note">iOS：保存时需要允许微信访问照片；不行可点「···」在 Safari 中打开再长按保存。</view>
      </view>
      <button class="btn-primary small" bindtap="onCloseTutorial">我知道了</button>
    </view>
  </view>
</view>
