<view class="page">
  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>基本信息</text></view>

    <view class="field">
      <text class="label">标题</text>
      <view class="content title">{{title || '无标题'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="title">复制</text>
    </view>

    <view class="field">
      <text class="label">up主</text>
      <view class="content">{{upName || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="upName">复制</text>
    </view>

    <view class="field">
      <text class="label">分区</text>
      <view class="content">{{partition || '未知'}}</view>
    </view>

    <view class="field">
      <text class="label">发布时间</text>
      <view class="content">{{pubText || '未知'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="pubText">复制</text>
    </view>

    <view class="field">
      <text class="label">标签</text>
      <view class="content"><text wx:if="{{tagsText}}">{{tagsText}}</text><text wx:else class="muted">无标签</text></view>
      <text class="action" bindtap="onCopyTag" data-field="tags">复制</text>
    </view>

    <view class="field">
      <text class="label">简介</text>
      <view class="content">{{desc || '无简介'}}</view>
      <text class="action" bindtap="onCopyTag" data-field="desc">复制</text>
    </view>
  </view>

  <!-- 帅哥录屏专属：只有该账号的稿件，后端才会返回 origin -->
  <view class="card source-card" wx:if="{{origin}}">
    <view class="sec-title">
      <text class="bar"></text>
      <image wx:if="{{origin.accountAvatarUrl}}" class="src-avatar" src="{{origin.accountAvatarUrl}}" mode="aspectFill" />
      <text>{{origin.accountName}} · 原up主是谁</text>
      <text class="push"></text>
      <text class="fan-chip">粉丝专属</text>
    </view>

    <view class="field">
      <text class="label">原平台</text>
      <view class="content {{origin.platformText === '—' ? 'muted' : ''}}">{{origin.platformText}}</view>
    </view>

    <view class="field">
      <text class="label">原up主</text>
      <view class="content {{origin.hasAuthor ? '' : 'muted'}}">{{origin.authorText}}</view>
      <text class="action" wx:if="{{origin.hasAuthor}}" bindtap="onCopyAuthorName">复制原up账号</text>
    </view>

    <view class="src-hint" wx:if="{{origin.pending}}">这条的出处还在整理，稍后再来看看</view>
  </view>

  <view class="visitor-tip" wx:if="{{publicView}}">以访客身份查看 · 登录后才能下载与导出</view>

  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>数据</text></view>
    <view class="stats-box">
      <view class="stat"><text class="stat-n">{{stats.like}}</text><text class="stat-l">点赞</text></view>
      <view class="stat"><text class="stat-n">{{stats.reply}}</text><text class="stat-l">评论</text></view>
      <view class="stat"><text class="stat-n">{{stats.favorite}}</text><text class="stat-l">收藏</text></view>
      <view class="stat"><text class="stat-n">{{stats.coin}}</text><text class="stat-l">投币</text></view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title"><text class="bar"></text><text>媒体</text></view>

    <view class="field">
      <text class="label">封面</text>
      <view class="content">
        <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="aspectFill" bindtap="onPreviewCover" bindlongpress="onSaveCover" />
        <text wx:else class="muted">无封面</text>
      </view>
    </view>

    <view class="field" wx:if="{{media.watermarked && !publicView}}">
      <text class="label">视频</text>
      <view class="content muted">{{mediaSize.watermarked || '单文件流，含音频'}}</view>
      <text class="action" bindtap="onDownloadVideo" data-kind="watermarked">下载</text>
    </view>

    <view class="field" wx:if="{{media.clean && !publicView}}">
      <text class="label">无水印视频</text>
      <view class="content muted">{{mediaSize.clean || '高清视频轨，不含音频'}}</view>
      <text class="action" bindtap="onDownloadVideo" data-kind="clean">下载</text>
    </view>

    <view class="field export-field" wx:if="{{media.audio && !publicView}}">
      <text class="label">纯音频</text>
      <view class="content muted">{{mediaSize.audio || '音频轨'}}</view>
      <text
        class="action {{exports.audio.state === 'downloading' ? 'disabled' : exports.audio.state === 'ready' ? 'primary' : ''}}"
        bindtap="onExportTap"
        data-kind="audio"
      >{{exports.audio.state === 'downloading' ? exports.audio.progress + '%' : exports.audio.state === 'ready' ? '保存' : exports.audio.state === 'saved' ? '再次保存' : exports.audio.state === 'failed' ? '重试' : '下载'}}</text>
      <view class="export-progress" wx:if="{{exports.audio.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.audio.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.audio.sizeText}}">{{exports.audio.sizeText}}</text>
      </view>
    </view>

    <!-- 下载进度 -->
    <view class="field" wx:if="{{downloading && !publicView}}">
      <text class="label">下载中</text>
      <view class="content">
        <view class="progress-wrap">
          <view class="progress-bar" style="width: {{downloadProgress}}%"></view>
        </view>
        <text class="progress-text">{{downloadProgress}}%{{downloadSizeText}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{!publicView}}">
    <view class="sec-title"><text class="bar"></text><text>文本</text></view>

    <view class="field export-field">
      <text class="label">字幕</text>
      <view class="content" wx:if="{{subtitles.length}}">
        <view wx:for="{{showAllSub ? subtitles : subPreview}}" wx:key="t" class="sub">{{item.timeText}} {{item.text}}</view>
        <view class="ops">
          <text class="action" bindtap="onToggleSub">{{showAllSub ? '收起' : '展开'}}</text>
          <text class="action" bindtap="onCopySub">复制</text>
          <text
            class="action {{exports.subtitle.state === 'downloading' ? 'disabled' : exports.subtitle.state === 'ready' ? 'primary' : ''}}"
            bindtap="onExportTap"
            data-kind="subtitle"
          >{{exports.subtitle.state === 'downloading' ? exports.subtitle.progress + '%' : exports.subtitle.state === 'ready' ? '保存' : exports.subtitle.state === 'saved' ? '再次保存' : exports.subtitle.state === 'failed' ? '重试' : '下载'}}</text>
        </view>
      </view>
      <view class="content muted" wx:else>无字幕</view>
      <view class="export-progress" wx:if="{{exports.subtitle.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.subtitle.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.subtitle.sizeText}}">{{exports.subtitle.sizeText}}</text>
      </view>
    </view>

    <view class="field export-field" wx:if="{{features.danmaku}}">
      <text class="label">弹幕</text>
      <view class="content" wx:if="{{danmakuCount}}">共 {{danmakuCount}} 条</view>
      <view class="content muted" wx:else>无弹幕</view>
      <view class="ops" wx:if="{{danmakuCount}}">
        <text
          class="action {{exports.danmaku.state === 'downloading' ? 'disabled' : exports.danmaku.state === 'ready' ? 'primary' : ''}}"
          bindtap="onExportTap"
          data-kind="danmaku"
        >{{exports.danmaku.state === 'downloading' ? exports.danmaku.progress + '%' : exports.danmaku.state === 'ready' ? '保存' : exports.danmaku.state === 'saved' ? '再次保存' : exports.danmaku.state === 'failed' ? '重试' : '下载'}}</text>
      </view>
      <view class="export-progress" wx:if="{{exports.danmaku.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.danmaku.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.danmaku.sizeText}}">{{exports.danmaku.sizeText}}</text>
      </view>
    </view>

    <view class="field export-field" wx:if="{{features.comment}}">
      <text class="label">评论</text>
      <view class="content" wx:if="{{stats.reply}}">共 {{stats.reply}} 条</view>
      <view class="content muted" wx:else>无评论</view>
      <view class="ops" wx:if="{{stats.reply}}">
        <text
          class="action {{exports.comment.state === 'downloading' ? 'disabled' : exports.comment.state === 'ready' ? 'primary' : ''}}"
          bindtap="onExportTap"
          data-kind="comment"
        >{{exports.comment.state === 'downloading' ? exports.comment.progress + '%' : exports.comment.state === 'ready' ? '保存' : exports.comment.state === 'saved' ? '再次保存' : exports.comment.state === 'failed' ? '重试' : '下载'}}</text>
      </view>
      <view class="export-progress" wx:if="{{exports.comment.state === 'downloading'}}">
        <view class="export-track"><view class="progress-bar" style="width: {{exports.comment.progress}}%"></view></view>
        <text class="export-progress-text" wx:if="{{exports.comment.sizeText}}">{{exports.comment.sizeText}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-ghost" wx:if="{{shareEnabled}}" open-type="share">分享</button>
    <button class="btn-primary" bindtap="onOpenBili">去 B站查看</button>
  </view>

  <view wx:if="{{previewing}}" class="preview-mask" bindtap="onClosePreview">
    <image class="preview-img" src="{{coverUrl}}" mode="aspectFit" />
    <view class="preview-save" catchtap="onSaveCover">保存到相册</view>
    <view class="preview-hint">点空白处关闭</view>
  </view>

  <view wx:if="{{fallbackVisible}}" class="preview-mask guide-mask">
    <view class="fallback-card" catchtap="">
      <view class="fallback-close" catchtap="onCloseFallback">✕</view>

      <view class="fallback-title">换一种方式保存</view>
      <view class="fallback-sub">当前视频链接暂不支持在小程序内直接保存</view>
      <view class="fallback-sub">复制链接后，用手机浏览器打开即可保存视频。</view>

      <view class="platform-row">
        <view class="platform-card">
          <view class="platform-head">
            <text class="platform-icon">🍎</text>
            <text class="platform-name">iPhone</text>
          </view>
          <view class="step"><text class="step-idx">1</text><text class="step-txt">复制链接</text></view>
          <view class="step"><text class="step-idx">2</text><text class="step-txt">Safari 打开</text></view>
          <view class="step"><text class="step-idx">3</text><text class="step-txt">保存到「文件」</text></view>
        </view>
        <view class="platform-card">
          <view class="platform-head">
            <text class="platform-icon">🤖</text>
            <text class="platform-name">Android</text>
          </view>
          <view class="step"><text class="step-idx">1</text><text class="step-txt">复制链接</text></view>
          <view class="step"><text class="step-idx">2</text><text class="step-txt">Chrome 打开</text></view>
          <view class="step"><text class="step-idx">3</text><text class="step-txt">点击下载</text></view>
        </view>
      </view>

      <view class="fallback-tip">链接可能有时效，请及时保存</view>
      <button class="btn-primary fallback-button" bindtap="onCopyFallback">复制链接</button>
    </view>
  </view>




</view>
