.page {
  padding: 24rpx 24rpx 60rpx;
  background: #f6f4f2;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(43, 30, 35, 0.05);
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fb7299;
}

.sec-title .bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #fb7299;
}

.field {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.label {
  flex: none;
  width: 140rpx;
  font-size: 24rpx;
  color: #9a8a90;
  padding-top: 4rpx;
}

.content {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #2b1e23;
  line-height: 1.5;
}

.content.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b1e23;
}

.muted,
.content.muted {
  color: #b7aab0;
}

.action {
  flex: none;
  font-size: 24rpx;
  color: #fb7299;
  padding: 6rpx 4rpx;
  line-height: 1;
}

.ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.stats-box {
  display: flex;
  align-items: center;
  background: #fff4f7;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  margin: 12rpx 0 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-n {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fb7299;
}

.stat-l {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.cover {
  width: 220rpx;
  height: 124rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(43, 30, 35, 0.12);
}

.sub {
  font-size: 24rpx;
  color: #5a4a50;
  line-height: 1.6;
}

.bottom-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-ghost {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 28rpx;
  color: #fb7299;
  background: #fff;
  border: 2rpx solid #fb7299;
  border-radius: 999rpx;
}

.btn-primary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 28rpx;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
}

.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-hint {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.preview-save {
  position: absolute;
  bottom: 110rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 18rpx 70rpx;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(251, 114, 153, 0.4);
}

.progress-wrap {
  width: 100%;
  height: 12rpx;
  background: #F0ECE8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #FB7299;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.fallback-card {
  position: relative;
  width: 648rpx;
  max-height: 68vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 52rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.fallback-title {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  color: #2b1e23;
  margin-bottom: 18rpx;
}

.fallback-sub {
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  color: #8a7b81;
}

.platform-row {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.platform-card {
  flex: 1;
  background: #faf7f8;
  border: 2rpx solid #f2ecee;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.platform-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.platform-icon {
  font-size: 32rpx;
  line-height: 1;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b1e23;
}

.step {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.step-idx {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fb7299;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.step-txt {
  font-size: 24rpx;
  color: #4b3b42;
  white-space: nowrap;
}

.fallback-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b28b97;
}

.fallback-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 31rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #fb7299;
  color: #fff;
}

.fallback-button::after {
  border: none;
}

.fallback-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8b8bd;
  font-size: 32rpx;
}

.guide-mask {
  align-items: center;
}

.export-field {
  flex-wrap: wrap;
}

.export-progress {
  flex-basis: 100%;
  margin-top: 8rpx;
}

.export-track {
  height: 12rpx;
  background: #F0ECE8;
  border-radius: 6rpx;
  overflow: hidden;
}

.export-progress-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.action.primary {
  color: #ffffff;
  background: #fb7299;
  border-color: #fb7299;
}

.action.disabled {
  opacity: 0.6;
}
