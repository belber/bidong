.page {
  padding: 24rpx 28rpx 60rpx;
  background: #FFFFFF;
  min-height: 100vh;
}

.cover {
  position: relative;
  width: 420rpx;
  margin: 0 auto;
  aspect-ratio: 16 / 9;
  border-radius: 28rpx;
  overflow: hidden;
}

.cover-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1b2440, #4a3f8f);
}

.cover-img {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.open-bili {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #FB7299;
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 750;
  color: #2B1E23;
  line-height: 1.4;
}

.up-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.ava {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FB7299, #ff9db9);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.uname {
  flex: 1;
  font-size: 26rpx;
  font-weight: 650;
  color: #2B1E23;
}

.meta-line {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 22rpx;
  color: #7A6A70;
}

.sec-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2B1E23;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7A6A70;
  line-height: 1.6;
}

.subtitle {
  margin-top: 32rpx;
  background: #FFF4F7;
  border: 1rpx solid #FBDDE6;
}

.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #2B1E23;
}

.sub-it {
  font-size: 24rpx;
  color: #5A4A50;
  line-height: 1.6;
  padding: 10rpx 0;
  border-top: 1rpx dashed #FBDDE6;
}

.sub-it:first-of-type {
  border-top: none;
}

.sub-t {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 20rpx;
  color: #B28B97;
  margin-right: 14rpx;
}

.sub-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sub-btn {
  flex: 1;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.copy-all {
  margin: 0;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #FB7299;
  background: #FFF4F7;
  border-radius: 999rpx;
}

.dur-field {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7A6A70;
  font-family: ui-monospace, Menlo, monospace;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.copy-btn {
  flex: none;
  font-size: 24rpx;
  color: #FB7299;
  padding: 2rpx 4rpx;
}
