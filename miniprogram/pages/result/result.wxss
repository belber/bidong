.page {
  padding: 24rpx 24rpx 60rpx;
  background: #f6f4f2;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(43, 30, 35, 0.05);
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fb7299;
}

.sec-title .bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #fb7299;
}

.field {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.label {
  flex: none;
  width: 140rpx;
  font-size: 24rpx;
  color: #9a8a90;
  padding-top: 4rpx;
}

.content {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #2b1e23;
  line-height: 1.5;
}

.content.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b1e23;
}

.muted,
.content.muted {
  color: #b7aab0;
}

.icon-btn {
  flex: none;
  font-size: 30rpx;
  padding: 4rpx 6rpx;
  color: #fb7299;
}

.text-btn {
  flex: none;
  font-size: 24rpx;
  color: #fb7299;
  padding: 4rpx 0;
}

.ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.stats-box {
  display: flex;
  align-items: center;
  background: #fff4f7;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  margin: 12rpx 0 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-n {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fb7299;
}

.stat-l {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a8a90;
}

.cover {
  width: 220rpx;
  height: 124rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(43, 30, 35, 0.12);
}

.sub {
  font-size: 24rpx;
  color: #5a4a50;
  line-height: 1.6;
}

.bottom-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-ghost {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  color: #fb7299;
  background: #fff;
  border: 2rpx solid #fb7299;
  border-radius: 999rpx;
}

.btn-primary {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
}
