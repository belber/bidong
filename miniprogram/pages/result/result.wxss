.page {
  padding: 24rpx 24rpx 60rpx;
  background: #faf9fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(43, 30, 35, 0.05);
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fb7299;
}

.sec-title .bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #fb7299;
}

.media-hint {
  margin: 2rpx 0 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff1f5;
  color: #a2586e;
  font-size: 22rpx;
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.label {
  flex: none;
  width: 140rpx;
  font-size: 24rpx;
  color: #9a8a90;
  padding-top: 4rpx;
}

.content {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #2b1e23;
  line-height: 1.5;
}

.content.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b1e23;
}

.clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.muted,
.content.muted {
  color: #b7aab0;
}

.action {
  flex: none;
  font-size: 24rpx;
  color: #fb7299;
  padding: 6rpx 4rpx;
  line-height: 1;
}

.ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

/* 帅哥录屏专属区块：琥珀配色与白色、粉色卡片区分，结构沿用 sec-title + field */
.source-card {
  border: 2rpx solid #e7b45b;
  background: linear-gradient(135deg, #fff8e6, #ffedc2);
  color: #704514;
}

.src-avatar {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.push {
  flex: 1;
}

.fan-chip {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  line-height: 1.4;
}

.src-hint {
  font-size: 22rpx;
  color: #b7aab0;
  padding: 0 0 20rpx 156rpx;
}

/* 未登录访客（含微信搜索爬虫打开）时的提示 */
.visitor-tip {
  margin: 0 0 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #fceaf0;
  color: #b28b97;
  font-size: 24rpx;
  text-align: center;
}

.cover {
  width: 220rpx;
  height: 124rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(43, 30, 35, 0.12);
}

.sub {
  font-size: 24rpx;
  color: #5a4a50;
  line-height: 1.6;
}

.bottom-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-ghost {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 28rpx;
  color: #fb7299;
  background: #fff;
  border: 2rpx solid #fb7299;
  border-radius: 999rpx;
}

.btn-primary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 28rpx;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
}

.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-hint {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.preview-save {
  position: absolute;
  bottom: 110rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 18rpx 70rpx;
  color: #fff;
  background: #fb7299;
  border-radius: 999rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(251, 114, 153, 0.4);
}

.progress-wrap {
  width: 100%;
  height: 12rpx;
  background: #F0ECE8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #FB7299;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.fallback-card {
  position: relative;
  width: 648rpx;
  max-height: 68vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 52rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.fallback-title {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  color: #2b1e23;
  margin-bottom: 18rpx;
}

.fallback-sub {
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  color: #8a7b81;
}

.platform-row {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.platform-card {
  flex: 1;
  background: #faf7f8;
  border: 2rpx solid #f2ecee;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.platform-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.platform-icon {
  font-size: 32rpx;
  line-height: 1;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b1e23;
}

.step {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.step-idx {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fb7299;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.step-txt {
  font-size: 24rpx;
  color: #4b3b42;
  white-space: nowrap;
}

.fallback-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b28b97;
}

.fallback-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 31rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #fb7299;
  color: #fff;
}

.fallback-button::after {
  border: none;
}

.fallback-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8b8bd;
  font-size: 32rpx;
}

.guide-mask {
  align-items: center;
}

.export-field {
  flex-wrap: wrap;
  align-items: center;
}

.download-field {
  align-items: center;
}

.export-progress {
  flex-basis: 100%;
  margin-top: 8rpx;
}

.export-track {
  height: 12rpx;
  background: #F0ECE8;
  border-radius: 6rpx;
  overflow: hidden;
}

.export-progress-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.action.primary {
  color: #ffffff;
  background: #fb7299;
  border-color: #fb7299;
}

.action.download-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #fb7299;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx rgba(251, 114, 153, 0.28);
}

.action.download-btn.primary {
  background: #e94f7f;
}

.action.download-btn.disabled {
  background: #e7c6d2;
  color: #ffffff;
  box-shadow: none;
  opacity: 0.9;
}

.action.disabled {
  opacity: 0.6;
}

.ad-banner {
  width: calc(100vw - 48rpx);
  height: calc((100vw - 48rpx) * 7 / 20);
  margin: 24rpx 0 48rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.countdown-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(43, 30, 35, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.countdown-card {
  width: 360rpx;
  padding: 40rpx 32rpx 36rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(43, 30, 35, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.countdown-track {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F7D5E0;
  overflow: hidden;
}

.countdown-bar {
  width: 42%;
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FB7299, #FF9DB9);
  animation: countdown-slide 1.2s ease-in-out infinite;
}

@keyframes countdown-slide {
  0% { transform: translateX(-110%); }
  100% { transform: translateX(260%); }
}

.countdown-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2B1E23;
}

.countdown-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8A90;
  text-align: center;
  line-height: 1.5;
}

/* 下载优先，文案按需；详细信息默认折叠。 */
.video-summary { margin-bottom: 24rpx; }
.summary-title { font-size: 34rpx; line-height: 1.55; font-weight: 650; word-break: break-all; }
.summary-author { margin-top: 18rpx; color: #8E8589; font-size: 26rpx; }
.more-toggle { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 650; min-height: 52rpx; }
.more-arrow { color: #E53935; font-size: 25rpx; font-weight: 400; }
.more-content { margin-top: 26rpx; border-top: 1rpx solid #F2E9EC; }
.more-content .card { padding: 22rpx 0; margin: 0; border-radius: 0; box-shadow: none; }

/* Reference cards: black headings, pink vector icons, compact inline media rows. */
.video-summary { padding: 26rpx 32rpx; }
.media-download-card,
.transcript-card { padding: 28rpx 32rpx; border-radius: 30rpx; }
.media-download-card { box-shadow: 0 8rpx 26rpx rgba(55, 31, 42, 0.045); }
.section-heading { display: flex; align-items: center; gap: 16rpx; min-height: 44rpx; color: #241e21; font-size: 31rpx; line-height: 1.4; font-weight: 650; }
.section-icon { flex: 0 0 40rpx; width: 40rpx; height: 40rpx; background-position: center; background-repeat: no-repeat; background-size: contain; }
.media-download-card .media-row { display: flex; align-items: center; flex-wrap: wrap; gap: 0; padding: 0; min-height: 96rpx; }
.media-download-card .section-heading { margin-bottom: 18rpx; }
.media-item-main { display: flex; align-items: center; flex: 1; min-width: 0; padding-right: 16rpx; }
.media-item-icon { flex: 0 0 42rpx; width: 42rpx; height: 42rpx; margin: 0 20rpx 0 12rpx; background-position: center; background-repeat: no-repeat; background-size: contain; }
.media-item-copy { flex: 1; min-width: 0; }
.media-item-line { line-height: 1.5; }
.media-item-name,.media-item-size { font-size: 28rpx; color: #858285; font-weight: 400; }
.media-item-size { overflow-wrap: break-word; }
.media-item-detail { margin-top: 4rpx; color: #a49ca0; font-size: 23rpx; line-height: 1.5; }
.media-download-card .action.download-btn { width: 150rpx; min-width: 150rpx; height: 60rpx; padding: 0 12rpx; border-radius: 999rpx; font-size: 27rpx; font-weight: 500; color: #fff; background: linear-gradient(110deg, #ff719f, #ff568f); box-shadow: none; }
.media-download-card .action.download-btn.disabled { background: #efcad7; }
.media-download-card .action.download-btn.primary { background: linear-gradient(110deg, #ff719f, #ff568f); }
.media-download-card .export-progress { margin: 0 0 12rpx; }
.media-download-status { padding: 4rpx 0 12rpx; }
.transcript-card { padding: 26rpx 32rpx; background: linear-gradient(115deg, #fff1f6, #fff5f8); box-shadow: none; }
.transcript-card .section-heading { margin-bottom: 0; }
.transcript-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.transcript-header .section-heading { flex: 1; min-width: 0; }
.transcript-action-row { margin-top: 22rpx; display: flex; align-items: center; gap: 18rpx; min-height: 78rpx; }
.transcript-status { display: flex; align-items: flex-start; flex: 1; min-width: 0; gap: 16rpx; }
.transcript-status-icon { flex: 0 0 38rpx; width: 38rpx; height: 38rpx; margin-top: 3rpx; background-position: center; background-repeat: no-repeat; background-size: contain; border-radius: 50%; box-sizing: border-box; }
.transcript-status-copy { min-width: 0; flex: 1; }
.transcript-state { color: #292125; font-size: 28rpx; line-height: 1.4; font-weight: 650; }
.transcript-meta,.transcript-hint { margin-top: 8rpx; color: #a29a9e; font-size: 23rpx; line-height: 1.5; }
.meta-divider { padding: 0 5rpx; color: #c7bec2; }
.transcript-button { flex: 0 0 204rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 204rpx; min-width: 204rpx; max-width: 204rpx; height: 64rpx; margin: 0; padding: 0 26rpx; border: 0; border-radius: 999rpx; color: #fff; background: linear-gradient(110deg, #ff719f, #ff568f); font-size: 27rpx; font-weight: 500; line-height: 1.4; }
.transcript-button[disabled] { color: #b38395; background: #f0d8e1; }
.transcript-chevron { width: 12rpx; height: 12rpx; border-top: 3rpx solid #fff; border-right: 3rpx solid #fff; transform: rotate(45deg); margin-right: 3rpx; }
.transcript-read-error { margin-top: 16rpx; color: #a17b89; font-size: 23rpx; }
.status-queued,.status-processing,.transcript-status-icon.is-submitting { background-image: none; border: 4rpx solid #f4c5d5; border-top-color: #ff6597; animation: transcript-spin 1s linear infinite; }
@keyframes transcript-spin { to { transform: rotate(360deg); } }
@media (max-width: 340px) {
  .media-download-card,.transcript-card { padding-left: 26rpx; padding-right: 26rpx; }
  .media-item-icon { margin-left: 0; margin-right: 14rpx; }
  .media-item-name,.media-item-size { font-size: 26rpx; }
  .transcript-status { gap: 12rpx; }
  .transcript-button { min-width: 170rpx; padding-left: 20rpx; padding-right: 20rpx; }
}
