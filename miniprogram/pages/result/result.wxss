.media-empty { padding: 22rpx 0 16rpx; color: #a49ca0; font-size: 26rpx; line-height: 1.6; }

.video-summary { display:flex; align-items:center; gap:24rpx; }
.summary-cover { flex:none; width:148rpx; height:176rpx; border-radius:18rpx; overflow:hidden; background:#FFF0F5; }
.summary-thumbnail { width:100%; height:100%; display:block; }
.summary-placeholder { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:#B78B9B; font-size:20rpx; }
.summary-copy { flex:1; min-width:0; }
.summary-title { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; font-size:30rpx; }
.summary-author { word-break:break-all; font-size:24rpx; }
@media (max-width:350px) { .summary-cover { width:124rpx; height:158rpx; } .media-item-line { flex-wrap:wrap; } }

.source-card .sec-title, .source-card .content { color: #704514; }
.source-card .label, .source-card .src-hint, .source-card .muted { color: #856337; }
.source-card .bar, .source-card .fan-chip { background: #966016; }
.source-card .action { color: #80500e; }
