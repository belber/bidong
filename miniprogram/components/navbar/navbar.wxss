.navbar {
  background: #FFFFFF;
}

.navbar-row {
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.tv-body {
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  width: 59rpx;
  height: 46rpx;
  background: #FB7299;
  border-radius: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tv-screen {
  width: 46rpx;
  height: 34rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tv-heart {
  color: #FB7299;
  font-size: 20rpx;
  line-height: 1;
}

.tv-antenna {
  position: absolute;
  top: 15rpx;
  width: 3rpx;
  height: 9rpx;
  background: #FB7299;
  border-radius: 2rpx;
}

.tv-dot {
  position: absolute;
  top: 8rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #FB7299;
}

.a-l {
  left: 27rpx;
}

.a-r {
  left: 50rpx;
}

.d-l {
  left: 25rpx;
}

.d-r {
  left: 48rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 750;
  color: #2B1E23;
  letter-spacing: -0.01em;
}
